-with-specific-groups\"},{\"id\":33651,\"title\":\"Investigate specific external user activity to determine risk posture\",\"link\":\"investigate-specific-external-user-activity-to-determine-risk-posture\"},{\"id\":33650,\"title\":\"Investigate specific internal user activity to determine risk posture\",\"link\":\"investigate-specific-internal-user-activity-to-determine-risk-posture\"},{\"id\":33645,\"title\":\"Identify and act on individual files or folders on a case by case basis\",\"link\":\"identify-and-act-on-individual-files-or-folders-on-a-case-by-case-basis\"},{\"id\":33567,\"title\":\"Alert when a file is made public\",\"link\":\"alert-when-a-file-is-made-public\"},{\"id\":33570,\"title\":\"Alert when a file is externally shared\",\"link\":\"alert-when-a-file-is-externally-shared\"}]},{\"id\":33581,\"title\":\"API (Protection for Managed App Activities)\",\"link\":\"api-protection-for-managed-app-activities\",\"items\":[{\"id\":33615,\"title\":\"Create a policy to allow sharing with approved external users\",\"link\":\"create-a-policy-to-allow-sharing-with-approved-external-users\"},{\"id\":33614,\"title\":\"Create a policy to block sharing with identified external users\",\"link\":\"create-a-policy-to-block-sharing-with-identified-external-users\"},{\"id\":33618,\"title\":\"Create a policy to identify and modify internal and external sharing\",\"link\":\"create-a-policy-to-identify-and-modify-internal-and-external-sharing\"}]},{\"id\":33628,\"title\":\"DLP – Protect state for Managed App Activities\",\"link\":\"dlp-protect-state-for-managed-app-activities\",\"items\":[{\"id\":33608,\"title\":\"Create a DLP policy to search an entire data repository and apply predefined labels per Enterprise data classification rules\",\"link\":\"create-a-dlp-policy-to-search-an-entire-data-repository-and-apply-predefined-labels-per-enterprise-data-classification-rules\"},{\"id\":33617,\"title\":\"Create a policy to identify sensitive data in specific locations (public, external or non-approved groups)\",\"link\":\"create-a-policy-to-identify-sensitive-data-in-specific-locations-public-external-or-non-approved-groups\"},{\"id\":33616,\"title\":\"Create a policy to alert or block sharing of sensitive data with external Teams\",\"link\":\"create-a-policy-to-alert-or-block-sharing-of-sensitive-data-with-external-teams\"},{\"id\":33619,\"title\":\"Create a policy to find encrypted or password protected files\",\"link\":\"create-a-policy-to-find-encrypted-or-password-protected-files\"},{\"id\":33620,\"title\":\"Create and apply a legal hold policy if required\",\"link\":\"create-and-apply-a-legal-hold-policy-if-required\"}]},{\"id\":33683,\"title\":\"Threat Protection – Protect state for Managed App Activities\",\"link\":\"threat-protection-protect-state-for-managed-app-activities\",\"items\":[{\"id\":33642,\"title\":\"Identify Malware in data repositories and action per defined policy\",\"link\":\"identify-malware-in-data-repositories-and-action-per-defined-policy\"}]}]},{\"id\":33603,\"title\":\"Cloud Inline Protection\",\"link\":\"cloud-inline-protection\",\"items\":[{\"id\":33643,\"title\":\"Inline monitoring for Cloud apps\",\"link\":\"inline-monitoring-for-cloud-apps\",\"items\":[{\"id\":33584,\"title\":\"Apply policies based on AD users, groups, or OU\",\"link\":\"apply-policies-based-on-ad-users-groups-or-ou\"},{\"id\":33589,\"title\":\"Apply policies based on the source of traffic\",\"link\":\"apply-policies-based-on-the-source-of-traffic\"},{\"id\":33591,\"title\":\"Apply policies based on the source of traffic, trusted, or untrusted networks\",\"link\":\"apply-policies-based-on-the-source-of-traffic-trusted-or-untrusted-networks\"},{\"id\":33587,\"title\":\"Apply policies based on the source of traffic, forward, or reverse proxy\",\"link\":\"apply-policies-based-on-the-source-of-traffic-forward-or-reverse-proxy\"},{\"id\":33585,\"title\":\"Apply policies based on the application instance\",\"link\":\"apply-policies-based-on-the-application-instance\"},{\"id\":33588,\"title\":\"Apply policies based on the constraint profile\",\"link\":\"apply-policies-based-on-the-constraint-profile\"},{\"id\":33590,\"title\":\"Apply policies to enforce step up authentication as required\",\"link\":\"apply-policies-to-enforce-step-up-authentication-as-required\"},{\"id\":33575,\"title\":\"Analyze user activity, such as uploads or posts, in cloud apps that create or shares content\",\"link\":\"analyze-user-activity-such-as-uploads-or-posts-in-cloud-apps-that-create-or-shares-content\"},{\"id\":33574,\"title\":\"Analyze and report on using corporate credentials on non-sanctioned apps\",\"link\":\"analyze-and-report-on-using-corporate-credentials-on-non-sanctioned-apps\"}]},{\"id\":33646,\"title\":\"Inline protection of Cloud apps\",\"link\":\"inline-protection-of-cloud-apps\",\"items\":[{\"id\":33572,\"title\":\"Allow access to a sanctioned instance of a supported corporate app\",\"link\":\"allow-access-to-a-sanctioned-instance-of-a-supported-corporate-app\"},{\"id\":33573,\"title\":\"Allow access to a sanctioned application based on app tag\",\"link\":\"allow-access-to-a-sanctioned-application-based-on-app-tag\"},{\"id\":33596,\"title\":\"Block risky activities to Unsanctioned/non-IT purchased apps\",\"link\":\"block-risky-activities-to-unsanctioned-non-it-purchased-apps\"},{\"id\":33593,\"title\":\"Block risky activities to Low / Poor CCL apps\",\"link\":\"block-risky-activities-to-low-poor-ccl-apps\"},{\"id\":33566,\"title\":\"Alert/block upon detection of password protected files\",\"link\":\"alert-block-upon-detection-of-password-protected-files\"},{\"id\":33602,\"title\":\"Coach users away from unsanctioned applications and allow justification of required use\",\"link\":\"coach-users-away-from-unsanctioned-applications-and-allow-justification-of-required-use\"}]}]}]}]},\"excluded_topics\":[105858,103968,100069,80591,57192]},\"langCode\":\"en\"}},\"children\":\"$L12\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"14:Tdcf,"])</script><script>self.__next_f.push([1,"\u003cp\u003eIn order to take full advantage of NewEdge Data Centers (DCs) and prevent service disruptions, you must \u003ca href=\"/en/ip-allowlisting/\" target=\"_blank\" rel=\"noreferrer noopener\"\u003eallowlist the IP ranges\u003c/a\u003e listed below for outbound traffic to NewEdge DCs and inbound traffic for source IP-restricted cloud applications. The IP ranges are used for both ingress and egress of NewEdge DCs. Therefore, any cloud applications that are locked down by IP range must be allowlisted to ensure that Netskope can access them for inline and API-based access.\u003c/p\u003e\n\n\n\n\u003ctable id=\"tablepress-1113\" class=\"tablepress tablepress-id-1113\"\u003e\n\u003cthead\u003e\n\u003ctr class=\"row-1\"\u003e\n\t\u003cth class=\"column-1\"\u003eCIDR Notation\u003c/th\u003e\u003cth class=\"column-2\"\u003eIP Address Range\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody class=\"row-striping row-hover\"\u003e\n\u003ctr class=\"row-2\"\u003e\n\t\u003ctd class=\"column-1\"\u003e8.36.116.0/24\u003c/td\u003e\u003ctd class=\"column-2\"\u003e8.36.116.0 \u0026#8211; 8.36.116.255\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr class=\"row-3\"\u003e\n\t\u003ctd class=\"column-1\"\u003e8.39.144.0/24\u003c/td\u003e\u003ctd class=\"column-2\"\u003e8.39.144.0 \u0026#8211; 8.39.144.255\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr class=\"row-4\"\u003e\n\t\u003ctd class=\"column-1\"\u003e31.186.239.0/24\u003c/td\u003e\u003ctd class=\"column-2\"\u003e31.186.239.0 \u0026#8211; 31.186.239.255\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr class=\"row-5\"\u003e\n\t\u003ctd class=\"column-1\"\u003e163.116.128.0/17\u003c/td\u003e\u003ctd class=\"column-2\"\u003e163.116.128.0 \u0026#8211; 163.116.255.255\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr class=\"row-6\"\u003e\n\t\u003ctd class=\"column-1\"\u003e162.10.0.0/17\u003c/td\u003e\u003ctd class=\"column-2\"\u003e162.10.0.0 \u0026#8211; 162.10.127.255\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\n\n\n\u003cp\u003eTo see IP ranges for other Netskope products and features, see \u003ca class=\"external-link\"  target=\"_blank\" rel=\"noreferrer noopener\" href=\"https://support.netskope.com/s/article/NewEdge-Consolidated-List-of-IP-Range-for-Allowlisting\"\u003eNewEdge Consolidated List of IP Ranges for Allowlisting\u003c/a\u003e. If you have any questions or concerns, contact your Netskope representative.\u003c/p\u003e\n\n\n\n\u003cdiv class=\"wp-block-simple-note-info\"\u003eThe NewEdge consolidated list of IP ranges link is accessible only to authorized customer contacts via login. If you do not have access, contact your Netskope sales representative or support team.\u003c/div\u003e\n\n\n\n\u003ch2 class=\"wp-block-heading\"\u003eAI Red Team IP Ranges for Allowlisting\u003c/h2\u003e\n\n\n\n\u003cp\u003eYou can add these outbound IP addresses to your allowlist to enable AI Red Team to connect to your service.\u003c/p\u003e\n\n\n\n\u003ctable id=\"tablepress-1485\" class=\"tablepress tablepress-id-1485\"\u003e\n\u003cthead\u003e\n\u003ctr class=\"row-1\"\u003e\n\t\u003cth class=\"column-1\"\u003eRegion\u003c/th\u003e\u003cth class=\"column-2\"\u003eData Center\u003c/th\u003e\u003cth class=\"column-3\"\u003eCIDR Notation\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody class=\"row-striping row-hover\"\u003e\n\u003ctr class=\"row-2\"\u003e\n\t\u003ctd class=\"column-1\"\u003eus-west-2\u003c/td\u003e\u003ctd class=\"column-2\"\u003eSV5\u003cbr /\u003e\nDFW3\u003cbr /\u003e\nSJC2\u003cbr /\u003e\nSJC1\u003c/td\u003e\u003ctd class=\"column-3\"\u003e18.98.10.112/28\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr class=\"row-3\"\u003e\n\t\u003ctd class=\"column-1\"\u003eap-southeast-1\u003c/td\u003e\u003ctd class=\"column-2\"\u003eSIN2\u003c/td\u003e\u003ctd class=\"column-3\"\u003e18.99.40.96/28\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr class=\"row-4\"\u003e\n\t\u003ctd class=\"column-1\"\u003eap-southeast-2\u003c/td\u003e\u003ctd class=\"column-2\"\u003eMEL2\u003c/td\u003e\u003ctd class=\"column-3\"\u003e18.98.196.32/28\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr class=\"row-5\"\u003e\n\t\u003ctd class=\"column-1\"\u003eeu-central-1\u003c/td\u003e\u003ctd class=\"column-2\"\u003eRUH1\u003cbr /\u003e\nAM2\u003cbr /\u003e\nFRA2\u003c/td\u003e\u003ctd class=\"column-3\"\u003e18.96.33.16/28\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr class=\"row-6\"\u003e\n\t\u003ctd class=\"column-1\"\u003eeu-central-2\u003c/td\u003e\u003ctd class=\"column-2\"\u003eZUR2\u003c/td\u003e\u003ctd class=\"column-3\"\u003e18.98.224.160/28\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr class=\"row-7\"\u003e\n\t\u003ctd class=\"column-1\"\u003eeu-west-2\u003c/td\u003e\u003ctd class=\"column-2\"\u003eLON3\u003c/td\u003e\u003ctd class=\"column-3\"\u003e18.98.162.192/28\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr class=\"row-8\"\u003e\n\t\u003ctd class=\"column-1\"\u003eap-south-1\u003c/td\u003e\u003ctd class=\"column-2\"\u003eBOM3\u003c/td\u003e\u003ctd class=\"column-3\"\u003e18.96.226.80/28\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e"])</script><script>self.__next_f.push([1,"6:[\"$\",\"$L13\",null,{\"url\":\"newedge-ip-ranges-for-allowlisting\",\"searchParams\":\"\",\"initialData\":{\"meta\":{\"title\":\"NewEdge IP Ranges for Allowlisting - Netskope Knowledge Portal\",\"description\":\"NewEdge IP Ranges for Allowlisting In order to take full advantage of NewEdge Data Centers (DCs) and prevent service disruptions, you must allowlist the IP ranges listed below for outbound traffic to NewEdge DCs and inbound traffic for source IP-restricted cloud applications. The IP ranges are used for both ingress and egress of NewEdge DCs. [\u0026hellip;]\",\"canonical\":\"https://docs.netskope.com/en/newedge-ip-ranges-for-allowlisting/\",\"robots\":\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\",\"og:locale\":\"en_US\",\"og:type\":\"artic