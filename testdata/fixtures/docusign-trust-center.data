/a></li><li><a href="https://www.docusign.com/legal/modern-slavery-act-statement" target="_self" class="css-yfy4wl e1tasy2f0" data-context="footer-bottom" data-action="modern slavery act statement"><div class="css-1eg020q e1tasy2f1">Modern Slavery Act Statement</div></a></li></ul><style data-emotion="css fwd0eo">.css-fwd0eo{font-size:0.75rem;font-weight:400;letter-spacing:0.2px;line-height:1.5;white-space:nowrap;color:#130032BF;}</style><div class="css-fwd0eo">© Docusign, Inc. 2026</div></div></div></section></footer><script id="optimizely-edge" type="text/javascript" src="/optimizely-edge/20917322951" referrerPolicy="no-referrer-when-downgrade"></script></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"content":{"sys":{"id":"61z8zqx7Ze0kqqPEAHHjkX","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"page"}},"locale":"en-US"},"fields":{"name":"Security for DocuSign eSignature","title":"Security for DocuSign eSignature","slug":"trust/security/esignature","seo":{"sys":{"id":"REBwNo8krbDQgAP43MXTU","type":"Entry","locale":"en-US"},"fields":{"name":"Security for DocuSign eSignature","title":"Security for DocuSign eSignature | Docusign","ogTitle":"Security for DocuSign eSignature","twitterTitle":"Security for DocuSign eSignature","canonicalUrl":"https://www.docusign.com/trust/security/esignature"}},"content":{"sys":{"id":"1ANLptxChhC6mrHbMR4A52","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"pagePageContentModularTwoColumn"}},"locale":"en-US"},"fields":{"name":"Security for DocuSign eSignature","topContent":[{"sys":{"id":"2hIK6FaRoS6Y6YHv844Lzq","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"moduleSubnav"}},"locale":"en-US"},"fields":{"name":"Trust Center Subnav","links":[{"sys":{"id":"3NbJddrAoFNHtW08fEeWv8","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicNavigationLink"}},"locale":"en-US"},"fields":{"name":"Trust Overview","linkText":"Overview","linkValue":{"sys":{"id":"3L1mKJC7JSVLCyD6L6Ce7B","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicLink"}},"locale":"en-US"},"fields":{"name":"Trust Center Overview","href":"https://www.docusign.com/trust"}},"target":"_self","dataAttributeValues":[{"key":"data-ga","value":"trustcenter|subnavigation|overview"}]}},{"sys":{"id":"4XI2i0uWrhX409XIyITgJO","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicNavigationLink"}},"locale":"en-US"},"fields":{"name":"Legal","linkText":"Legal","linkValue":{"sys":{"id":"3P258bthzbeQonnY3fSQjH","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicLink"}},"locale":"en-US"},"fields":{"name":"Legal","href":"https://www.docusign.com/trust/legal"}},"target":"_self","dataAttributeValues":[{"key":"data-ga","value":"trustcenter|subnavigation|legal"}]}},{"sys":{"id":"56hJ0Qdyu9cvv6zPbyehOq","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicNavigationLink"}},"locale":"en-US"},"fields":{"name":"Alerts","linkText":"Alerts","linkValue":{"sys":{"id":"HfBaiM3NyZaSgO4RQSSfj","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicLink"}},"locale":"en-US"},"fields":{"name":"Alerts","href":"https://www.docusign.com/trust/alerts"}},"target":"_self","dataAttributeValues":[{"key":"data-ga","value":"trustcenter|subnavigation|alerts"}]}},{"sys":{"id":"4bCcMu2S2QL2Q3tWOqOazy","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicNavigationLink"}},"locale":"en-US"},"fields":{"name":"Compliance","linkText":"Compliance","linkValue":{"sys":{"id":"2MjHJK3ktIQhQ2VWeJqFvd","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicLink"}},"locale":"en-US"},"fields":{"name":"Compliance","href":"https://www.docusign.com/trust/compliance"}},"target":"_self","dataAttributeValues":[{"key":"data-ga","value":"trustcenter|subnavigation|compliance"}]}},{"sys":{"id":"5roS15r3qcdbNawUHi7qgk","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicNavigationLink"}},"locale":"en-US"},"fields":{"name":"Privacy","linkText":"Privacy","linkValue":{"sys":{"id":"7iJeSHTPPz34EORlDJvbmZ","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicLink"}},"locale":"en-US"},"fields":{"name":"Privacy","href":"https://www.docusign.com/trust/privacy"}},"target":"_self","dataAttributeValues":[{"key":"data-ga","value":"trustcenter|subnavigation|privacy"}]}},{"sys":{"id":"3dCkheRyiHtWUee31g5Ir2","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicNavigationLink"}},"locale":"en-US"},"fields":{"name":"Security","linkText":"Security","linkValue":{"sys":{"id":"7F3eLFFyd6Qs4GSQKtq6qy","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicLink"}},"locale":"en-US"},"fields":{"name":"Security","href":"https://www.docusign.com/trust/security"}},"target":"_self","dataAttributeValues":[{"key":"data-ga","value":"trustcenter|subnavigation|security"}]}},{"sys":{"id":"OT2H3O7BhSTdFiCyJ9cLH","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicNavigationLink"}},"locale":"en-US"},"fields":{"name":"System Status","linkText":"System Status","linkValue":{"sys":{"id":"33lJazSNLTo5baaRPGQY3i","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicLink"}},"locale":"en-US"},"fields":{"name":"System Status","href":"https://www.docusign.com/trust/system-status"}},"target":"_self","dataAttributeValues":[{"key":"data-ga","value":"trustcenter|subnavigation|system status"}]}},{"sys":{"id":"KgU7EyLpNbNl05Sw77TIW","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicNavigationLink"}},"locale":"en-US"},"fields":{"name":"Trust Portal","linkText":"Trust Portal","linkValue":{"sys":{"id":"6KUxzl3zWztxTK4SrbE8M2","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicLink"}},"locale":"en-US"},"fields":{"name":"Trust Portal Landing Page","href":"https://www.docusign.com/trust/trust-portal"}},"target":"_self","dataAttributeValues":[{"key":"data-ga","value":"trustcenter|subnavigation|trustportal"}]}}],"title":"Trust Center"}}],"pageContent":[{"sys":{"id":"3T1P8Y6GaWIuMRom3R3z5E","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"moduleArticle"}},"locale":"en-US"},"fields":{"name":"Security for Docusign eSignature","body":{"nodeType":"document","data":{},"content":[{"nodeType":"heading-1","data":{},"content":[{"nodeType":"text","value":"Security for Docusign eSignature","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Security is in Docusign’s DNA, and like all of our products, Docusign eSignature is researched, designed, and developed with security as a top priority.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"This document outlines the security technologies, policies, and practices that protect your documents and data within Docusign eSignature, including information that enables you to configure security in accordance with the specific risk management and compliance requirements of your organization. For security details common to all Docusign products, ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.docusign.com/trust/security/product-security"},"content":[{"nodeType":"text","value":"visit product security on the Trust Center","marks":[],"data":{}}]},{"nodeType":"text","value":".","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Physical and logical security","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Docusign maintains around-the-clock onsite security with strict physical access control that complies with industry-recognized standards, such as SOC 1, SOC 2, and ISO 27001.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"We also use world-class security software and hardware to protect the physical integrity of Docusign eSignature and all associated computer systems and networks that process customer data. We do this through a centralized management system that controls access to the production environment through a global two-factor authentication process.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"This isolated production environment is protected by industry-leading network management systems, anti-virus software, and malware detectors. The anti-virus software is integrated with processes that automatically generate alerts to Docusign’s cyber incident response team if potentially harmful code is detected.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Security testing and vulnerability management","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The quality and integrity of Docusign eSignature is ensured by a formal product development lifecycle that includes secure coding practices in accordance with OWASP. Rigorous automated and manual code reviews are designed to pinpoint security weaknesses. We also perform internal and external vulnerability scans and penetration tests against the Docusign eSignature production environment. Any identified weaknesses from these industry-compliant tests are remedied in a commercially reasonable manner and in a timeframe commensurate with their severity","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Security monitoring","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"We monitor Docusign eSignature from both an operational and a security perspective. Intrusion prevention and detection events are logged, and tailored alerts are sent to our operations and security teams to ensure that Docusign eSignature can be used without security exposure from any location by those authorized to access it.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Storage, encryption, and disposal","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"To ensure your data stays protected, Docusign follows industry best practices to:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Logically separate individual customer data","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Encrypt customer data—all data access and transfer activities use HTTPS and other secure protocols, such as SSL, SSH, IPsec, SFTP, or secure channel signing and sealing","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Support only recognized cipher suites","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Encrypt all documents with AES 256-bit encryption or the most recent FIPS-approved methods","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Provide non-repudiation for all documents generated and signed using Docusign via a Certificate of Completion","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Maintain a data disposal and re-use policy for managing data assets","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Implement processes for equipment management and secure media disposal","marks":[],"data":{}}]}]}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Business continuity and disaster recovery","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Docusign maintains written business continuity and disaster recovery plans that ensure the continuing availability of Docusign eSignature. The continuity plan includes crisis management, business recovery, and infrastructure elements, and we test both plans on an annual basis in accordance with ISO 27001 controls.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Configurable security features","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Docusign eSignature offers the following customer-configurable features:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Multi-factor authentication ","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":"provides an additional level of assurance that only those authorized to access Docusign eSignature and associated documents can access them","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Role-based authorization ","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":"for all business transaction types enables you to designate access to specific individual","marks":[],"data":{}}]}]}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Allowlists for Docusign eSignature service","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Our top priority is to make your Docusign eSignature experience safe and secure, and it’s our intention to provide the most robust and reliable service possible to enable your business transactions. We also want to proactively share information that may be of interest to you regarding our service and understand the requirement to configure security to the needs of your organization.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Docusign customers should configure their spam filters and other software to allow for the following allowlisted domains to be accepted. If they want to further restrict access to and from Docusign services they should follow the guidance below.","marks":[],"data":{}}]},{"nodeType":"heading-4","data":{},"content":[{"nodeType":"text","value":"Connections to Docusign","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"For connections coming from your network/users/integrations to Docusign we recommend allowlisting the following domains: ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"embedded-entry-inline","data":{"target":{"sys":{"id":"23pbpvOUawItDHwM4VvwyH","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicTrustNetworkRecord"}},"locale":"en-US"},"fields":{"name":"eSignature docusign domains","recordCategory":"domains","product":"esignature","usage":"service_access","domains":["*.docusign.com","*.docusign.net"]}}},"content":[]},{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"In addition Docusign is the process of expanding our use of Akamai for both CDN and WAF purposes. The usage of these services are designed to enhance both network performance and security and require allowlisting of the following additional domains:","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"embedded-entry-inline","data":{"target":{"sys":{"id":"137lIzFKtMSuzoyn2OPvlT","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicTrustNetworkRecord"}},"locale":"en-US"},"fields":{"name":"eSignature docusign additional domains","recordCategory":"domains","product":"esignature","usage":"service_access","domains":["*.edgekey.net","*.akamaiedge.net","docucdn-a.akamaihd.net","ronp-a.akamaihd.net"]}}},"content":[]},{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Due to our use of Akamai and the way it operates we are unable to provide IP addresses for incoming connections to Docusign and can no longer support IP allowlisting for these types of connections.","marks":[{"type":"italic"},{"type":"bold"}],"data":{}},{"nodeType":"text","value":" ","marks":[],"data":{}}]},{"nodeType":"heading-4","data":{},"content":[{"nodeType":"text","value":"Connections from Docusign","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"If customers need to restrict access into their network/integration from Docusign the following IP addresses apply. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Please note: these IP addresses can and likely will change over time and we recommend reviewing the page on a regular basis to ensure you have the latest list of IPs. We also publish any IP changes as part of our release notes. ","marks":[{"type":"bold"},{"type":"italic"}],"data":{}}]},{"nodeType":"heading-5","data":{},"content":[{"nodeType":"text","value":"North America-based and demo accounts (current and continuing):","marks":[{"type":"bold"}],"data":{}}]},