ry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicImageAsset"}},"locale":"en-US"},"fields":{"name":"Image Asset: Footer - LinkedIn Social Share","image":{"sys":{"id":"1RsoMnpui9maxOeftZkV9o","type":"Asset","locale":"en-US"},"fields":{"title":"Image: Footer - LinkedIn Social","description":"","file":{"url":"//images.ctfassets.net/0jnmtsdzg6p5/1RsoMnpui9maxOeftZkV9o/e0c28f73afaefcd99fb1ef141fd9523f/LinkedIn__1_.svg","details":{"size":686,"image":{"width":24,"height":24}},"fileName":"LinkedIn (1).svg","contentType":"image/svg+xml"}}},"description":"View Docusign on LinkedIn","quality":50,"format":"svg"}},"icon":"LINKEDIN","target":"_self","dataAttributeValues":[{"key":"action","value":"linkedin"}]}}],"downloadLinks":[{"sys":{"id":"7reUu4CkObdtHIQRkOsYps","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicNavigationLink"}},"locale":"en-US"},"fields":{"name":"\"Google Play\" | \"Download the Docusign Mobile App on Google Play\" | https://play.google.com/store/apps/details?id=com.docusign.ink\u0026referrer=utm_source%3Demail%26utm_medium%3Dfooter%26utm_term%3Dwwwr","linkText":"Google Play","linkSubtext":"Download the Docusign Mobile App on Google Play","linkValue":{"sys":{"id":"7Lb6giHzgo4lNXz7qzATTc","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicLink"}},"locale":"en-US"},"fields":{"name":"https://play.google.com/store/apps/details?id=com.docusign.ink\u0026referrer=utm_source%3Demail%26utm_medium%3Dfooter%26utm_term%3Dwwwr","href":"https://play.google.com/store/apps/details?id=com.docusign.ink\u0026referrer=utm_source%3Demail%26utm_medium%3Dfooter%26utm_term%3Dwwwr"}},"image":{"sys":{"id":"1ajp44LaOQUj8Gv5lg9yYn","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicImageAsset"}},"locale":"en-US"},"fields":{"name":"Download the Docusign Mobile App on Google Play | Image Asset: Footer Nav Google Play Download","image":{"sys":{"id":"2AllED5U03vd2cebLfB6rU","type":"Asset","locale":"en-US"},"fields":{"title":"Image: Footer - Google Play badge","description":"","file":{"url":"//images.ctfassets.net/0jnmtsdzg6p5/2AllED5U03vd2cebLfB6rU/531a6780832941786e6ed77e0ad694dd/badge-google-play.png","details":{"size":4122,"image":{"width":256,"height":84}},"fileName":"badge-google-play.png","contentType":"image/png"}}},"description":"Download the Docusign Mobile App on Google Play"}},"target":"_self","dataAttributeValues":[{"key":"action","value":"google play"}]}},{"sys":{"id":"3avahhiod9IcuDAEVY1Or1","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicNavigationLink"}},"locale":"en-US"},"fields":{"name":"\"Apple\" | https://docusign.onelink.me/NBWo/docusigncta1","linkText":"Apple","linkSubtext":"Download the Docusign Mobile App on the Apple App Store","linkValue":{"sys":{"id":"72ySqMgO2YuXgltRsux6Od","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicLink"}},"locale":"en-US"},"fields":{"name":"Docusign Apple App Store | https://apps.apple.com/us/app/docusign-upload-sign-docs/id474990205","href":"https://apps.apple.com/us/app/docusign-upload-sign-docs/id474990205"}},"image":{"sys":{"id":"3ZIOimEE2ERXlWP6rqxfX8","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicImageAsset"}},"locale":"en-US"},"fields":{"name":"Download the Docusign Mobile App on the Apple App Store | Image Asset: Footer Nav Apple App Store Download","image":{"sys":{"id":"4WOSOeq00xri7k11Xb3kkF","type":"Asset","locale":"en-US"},"fields":{"title":"Image: Footer - Apple App Store badge","description":"","file":{"url":"//images.ctfassets.net/0jnmtsdzg6p5/4WOSOeq00xri7k11Xb3kkF/5a2503a98c82d94aa387922221f3daea/badge-app-store.png","details":{"size":3429,"image":{"width":256,"height":84}},"fileName":"badge-app-store.png","contentType":"image/png"}}},"description":"Download the Docusign Mobile App on the Apple App Store","quality":50,"format":"webp"}},"target":"_self","dataAttributeValues":[{"key":"action","value":"apple app store"}]}}]}}}},"seo":{"sys":{"id":"REBwNo8krbDQgAP43MXTU","type":"Entry","locale":"en-US"},"fields":{"name":"Security for DocuSign eSignature","title":"Security for DocuSign eSignature | Docusign","ogTitle":"Security for DocuSign eSignature","twitterTitle":"Security for DocuSign eSignature","canonicalUrl":"https://www.docusign.com/trust/security/esignature"}}}},"isDraftMode":false,"locale":"en-US","title":"Security for DocuSign eSignature","pageContentModules":[{"id":"3T1P8Y6GaWIuMRom3R3z5E","contentTypeId":"moduleArticle","props":{"richTextDocument":{"nodeType":"document","data":{},"content":[{"nodeType":"heading-1","data":{},"content":[{"nodeType":"text","value":"Security for Docusign eSignature","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Security is in Docusign’s DNA, and like all of our products, Docusign eSignature is researched, designed, and developed with security as a top priority.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"This document outlines the security technologies, policies, and practices that protect your documents and data within Docusign eSignature, including information that enables you to configure security in accordance with the specific risk management and compliance requirements of your organization. For security details common to all Docusign products, ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.docusign.com/trust/security/product-security"},"content":[{"nodeType":"text","value":"visit product security on the Trust Center","marks":[],"data":{}}]},{"nodeType":"text","value":".","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Physical and logical security","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Docusign maintains around-the-clock onsite security with strict physical access control that complies with industry-recognized standards, such as SOC 1, SOC 2, and ISO 27001.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"We also use world-class security software and hardware to protect the physical integrity of Docusign eSignature and all associated computer systems and networks that process customer data. We do this through a centralized management system that controls access to the production environment through a global two-factor authentication process.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"This isolated production environment is protected by industry-leading network management systems, anti-virus software, and malware detectors. The anti-virus software is integrated with processes that automatically generate alerts to Docusign’s cyber incident response team if potentially harmful code is detected.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Security testing and vulnerability management","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The quality and integrity of Docusign eSignature is ensured by a formal product development lifecycle that includes secure coding practices in accordance with OWASP. Rigorous automated and manual code reviews are designed to pinpoint security weaknesses. We also perform internal and external vulnerability scans and penetration tests against the Docusign eSignature production environment. Any identified weaknesses from these industry-compliant tests are remedied in a commercially reasonable manner and in a timeframe commensurate with their severity","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Security monitoring","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"We monitor Docusign eSignature from both an operational and a security perspective. Intrusion prevention and detection events are logged, and tailored alerts are sent to our operations and security teams to ensure that Docusign eSignature can be used without security exposure from any location by those authorized to access it.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Storage, encryption, and disposal","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"To ensure your data stays protected, Docusign follows industry best practices to:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Logically separate individual customer data","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Encrypt customer data—all data access and transfer activities use HTTPS and other secure protocols, such as SSL, SSH, IPsec, SFTP, or secure channel signing and sealing","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Support only recognized cipher suites","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Encrypt all documents with AES 256-bit encryption or the most recent FIPS-approved methods","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Provide non-repudiation for all documents generated and signed using Docusign via a Certificate of Completion","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Maintain a data disposal and re-use policy for managing data assets","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Implement processes for equipment management and secure media disposal","marks":[],"data":{}}]}]}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Business continuity and disaster recovery","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Docusign maintains written business continuity and disaster recovery plans that ensure the continuing availability of Docusign eSignature. The continuity plan includes crisis management, business recovery, and infrastructure elements, and we test both plans on an annual basis in accordance with ISO 27001 controls.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Configurable security features","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Docusign eSignature offers the following customer-configurable features:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Multi-factor authentication ","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":"provides an additional level of assurance that only those authorized to access Docusign eSignature and associated documents can access them","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Role-based authorization ","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":"for all business transaction types enables you to designate access to specific individual","marks":[],"data":{}}]}]}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Allowlists for Docusign eSignature service","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Our top priority is to make your Docusign eSignature experience safe and secure, and it’s our intention to provide the most robust and reliable service possible to enable your business transactions. We also want to proactively share information that may be of interest to you regarding our service and understand the requirement to configure security to the needs of your organization.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Docusign customers should configure their spam filters and other software to allow for the following allowlisted domains to be accepted. If they want to further restrict access to and from Docusign services they should follow the guidance below.","marks":[],"data":{}}]},{"nodeType":"heading-4","data":{},"content":[{"nodeType":"text","value":"Connections to Docusign","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"For connections coming from your network/users/integrations to Docusign we recommend allowlisting the following domains: ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"embedded-entry-inline","data":{"target":{"sys":{"id":"23pbpvOUawItDHwM4VvwyH","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicTrustNetworkRecord"}},"locale":"en-US"},"fields":{"name":"eSignature docusign domains","recordCategory":"domains","product":"esignature","usage":"service_access","domains":["*.docusign.com","*.docusign.net"]}}},"content":[]},{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"In addition Docusign is the process of expanding our use of Akamai for both CDN and WAF purposes. The usage of these services are designed to enhance both network performance and security and require allowlisting of the following additional domains:","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"embedded-entry-inline","data":{"target":{"sys":{"id":"137lIzFKtMSuzoyn2OPvlT","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicTrustNetworkRecord"}},"locale":"en-US"},"fields":{"name":"eSignature docusign additional domains","recordCategory":"domains","product":"esignature","usage":"service_access","domains":["*.edgekey.net","*.akamaiedge.net","docucdn-a.akamaihd.net","ronp-a.akamaihd.net"]}}},"content":[]},{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Due to our use of Akamai and the way it operates we are unable to provide IP addresses for incoming connections to Docusign and can no longer support IP allowlisting for these types of connections.","marks":[{"type":"italic"},{"type":"bold"}],"data":{}},{"nodeType":"text","value":" ","marks":[],"data":{}}]},{"nodeType":"heading-4","data":{},"content":[{"nodeType":"text","value":"Connections from Docusign","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"If customers need to restrict access into their network/integration from Docusign the following IP addresses apply. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Please note: these IP addresses can and likely will change over time and we recommend reviewing the page on a regular basis to ensure you have the latest list of IPs. We also publish any IP changes as part of our release notes. ","marks":[{"type":"bold"},{"type":"italic"}],"data":{}}]},{"nodeType":"heading-5","data":{},"content":[{"nodeType":"text","value":"North America-based and demo accounts (current and continuing):","marks":[{"type":"bold"}],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"embedded-entry-inline","data":{"target":{"sys":{"id":"58qyTgy0C9Pucz6tJw12jQ","type":"Entry","contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"topicTrustNetworkRecord"}},"locale":"en-US"},"fields":{"name":"eSignature - North America-based and demo accounts","recordCategory":"ranges","product":"esignature","usage":"connect_outbound","region":"NA","networkValues":[{"id":"6da160a1-8077-4100-ad04-b53e8a7be8c7","key":"209.112.104.1 - 209.112.107.254","value":"209.112.104.0/22"},{"id":"af437692-1775-4611-96e0-e26a907974a9","key":"64.207.216.1 - 64.207.219.254","value":"64.207.216.0/22"},{"id":"b5cadd13-25e8-4d08-92e8-dd277dbea242","key":"162.248.184.1 - 162.248.187.254","value":"162.248.184.0/22"},{"id":"b41eb161-cadf-474d-80f6-c8ecd8a19e80","key":"20.12.134.144 - 20.12.134.159","value":"20.12.134.144/28"},{"id":"678bb43c-3467-42fc-afa0-ae3983d28adb","key":"20.253.118.128 - 20.253.118.143","value":"20.253.118.128/28"},{"id":"deb5c028-c4b7-479f-ba07-d5ff4e9b7981","key":"20.7.89.192 - 20.7.89.207","value":"20.7.89.192/28"},{"id":"c5b13cf6-3de1-4fe4-98af-543a02e6673e","key":"20.171.224.80 - 20.171.224.95","value":"20.171.224.80/28"},{"id":"17ccf222-bbf3-4adc-b6ae-892bdd4ec060","key":"20.12.135.144 - 20.12.135.159","value":"20.12.135.144/28"},{"id":"99691bc8-f0f5-4ef7-94e2-7e273159b8c5","key":"20.253.118.160 - 20.253.118.175","value":"20.253.118.160/28"},{"id":"0a1499bd-3a59-4174-9323-13f7f148d99c","key":"20.7.90.48 - 20.7.90.63","value":"20.7.90.48/28"},{"id":"a871b44d-f988-4f7a-a879-be344c174e00","key":"20.40.31.128 - 20.40.31.143","value":"20.40.31.128/28"},{"id":"6ac73c14-8ece-47ff-bcac-33537c2371e1","key":"20.12.135.160 - 20.12.135.175","value":"20.12.135.160/28"},{"id":"d0f99802-234d-45e7-9d90-c7820ff2c6e7","key":"20.253.118.176 - 20.253.118.191","value":"20.253.118.176/28"},{"id":"3d17fbb8-594b-4bfd-a043-2074