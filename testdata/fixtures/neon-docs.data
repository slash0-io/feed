uppercase\",\"children\":\"note\"}]]}],[\"$\",\"div\",null,{\"className\":\"admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [\u0026_a]:rounded-sm [\u0026_li]:text-base [\u0026_li]:leading-snug [\u0026_li]:tracking-extra-tight [\u0026_ul]:my-0 [\u0026_ol]:my-0\",\"children\":[\"$\",\"p\",null,{\"children\":[\"After you select a region for a Neon project, it cannot be changed for that project. To run your database in a different region, create a \",[\"$\",\"strong\",null,{\"children\":\"new\"}],\" project there and migrate your data. See \",[\"$\",\"$L7c\",null,{\"href\":\"/docs/import/region-migration\",\"children\":\"Region migration\"}],\".\"]}]}]]}]\n"])</script><script>self.__next_f.push([1,"6c:[\"$\",\"h2\",null,{\"id\":\"check-which-region-your-project-uses\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Check which region your project uses\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#check-which-region-your-project-uses\",\"aria-label\":\"Link to Check which region your project uses\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$4c:4:props:children:1:props:children:props:children\"}]}]]}]\n6d:[\"$\",\"p\",null,{\"children\":\"To find the region an existing project runs in, use any of these:\"}]\n6e:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Console:\"}],\" open the project and check the \",[\"$\",\"strong\",null,{\"children\":\"Settings\"}],\" widget on the \",[\"$\",\"strong\",null,{\"children\":\"Project Dashboard\"}],\". The region is listed alongside the cloud provider.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"CLI:\"}],\" run \",[\"$\",\"code\",null,{\"children\":\"neon projects list\"}],\" or \",[\"$\",\"code\",null,{\"children\":\"neon projects get \u003cproject_id\u003e\"}],\". The output includes the region ID (for example, \",[\"$\",\"code\",null,{\"children\":\"aws-us-east-2\"}],\").\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Connection string:\"}],\" the region is the segment before \",[\"$\",\"code\",null,{\"children\":\".aws.neon.tech\"}],\" in the hostname. For example, \",[\"$\",\"code\",null,{\"children\":\"us-east-2.aws.neon.tech\"}],\" is AWS US East (Ohio).\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"API:\"}],\" read the \",[\"$\",\"code\",null,{\"children\":\"region_id\"}],\" field from \",[\"$\",\"code\",null,{\"children\":\"GET /projects/{project_id}\"}],\".\"]}],\"\\n\"]}]\n6f:[\"$\",\"p\",null,{\"children\":\"All branches and databases in a project share the project's region, so the project region is the region for everything inside it.\"}]\n70:[\"$\",\"h2\",null,{\"id\":\"nat-gateway-ip-addresses\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"NAT Gateway IP addresses\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#nat-gateway-ip-addresses\",\"aria-label\":\"Link to NAT Gateway IP addresses\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fil