ce-file="index.tsx"><div class="code-blocks_code-actions__Mkfd3"><code class="code-blocks_filename__sQPMo"></code></div><div data-mdast="ignore" class="code-blocks_copied__PBcgM" style="opacity:0">Copied</div><div><pre class="language-plaintext"><code class="language-plaintext code-highlight"><span class="code-line">34.125.65.3/32
