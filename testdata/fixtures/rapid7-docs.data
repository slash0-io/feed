appsec/bamboo-integration/index.mdx\",\"timestamp\":1783707814950},\"title\":\"HIDDEN\"},{\"name\":\"github-actions-integration\",\"route\":\"/insightappsec/github-actions-integration\",\"frontMatter\":{\"title\":\"Add Application Security (InsightAppSec) Scans into your GitHub Workflow | Application Security Documentation\",\"excerpt\":\"This article covers the Application Security (InsightAppSec) integration with Github to add Application Security (InsightAppSec) scans to your DevOps pipelines, which provides better visibility and prioritization of vulnerabilities, as well as preventing risky code from entering the production environment.\",\"filePath\":\"src/content/insightappsec/github-actions-integration/index.mdx\",\"timestamp\":1783707814950},\"title\":\"GitHub Actions Integration\"},{\"name\":\"gitlab-integration\",\"route\":\"/insightappsec/gitlab-integration\",\"frontMatter\":{\"title\":\"Integrate Application Security (InsightAppSec) with GitLab | Application Security Documentation\",\"excerpt\":\"Integrate Application Security (InsightAppSec) scans into the Gitlab CI pipeline by updating your build pipeline to include the scanning steps, which will then automate a DAST scan as part of that Gitlab CI build.\",\"filePath\":\"src/content/insightappsec/gitlab-integration/index.mdx\",\"timestamp\":1783707814950},\"title\":\"GitLab Integration\"},{\"name\":\"---4\",\"type\":\"separator\",\"title\":\"Manage Apps\"},{\"name\":\"add-an-app\",\"route\":\"/insightappsec/add-an-app\",\"frontMatter\":{\"title\":\"Add and Delete Apps | Application Security Documentation\",\"excerpt\":\"Learn how to add an app that allows you to group several scan targets together and delete apps you no longer need.\",\"filePath\":\"src/content/insightappsec/add-an-app/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Manage Apps\"},{\"name\":\"manage_app_files\",\"route\":\"/insightappsec/manage_app_files\",\"frontMatter\":{\"title\":\"Manage App Files | Application Security Documentation\",\"excerpt\":\"Learn how to manage files an existing App.\",\"filePath\":\"src/content/insightappsec/manage_app_files/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Manage App Files\"},{\"name\":\"tag-apps\",\"route\":\"/insightappsec/tag-apps\",\"frontMatter\":{\"title\":\"Application Tagging | Application Security Documentation\",\"excerpt\":\"This article covers why and how you can tag applications in Application Security (InsightAppSec) to improve organization and search.\",\"filePath\":\"src/content/insightappsec/tag-apps/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Application Tagging\"},{\"name\":\"manage-user-access\",\"route\":\"/insightappsec/manage-user-access\",\"frontMatter\":{\"title\":\"Manage User Access | Application Security Documentation\",\"excerpt\":\"This article covers how to manage access to Application Security (InsightAppSec) apps by assigning app-level user permissions.\",\"filePath\":\"src/content/insightappsec/manage-user-access/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Manage User Access\"},{\"name\":\"---5\",\"type\":\"separator\",\"title\":\"Scan for Vulnerabilities\"},{\"name\":\"scan-configuration\",\"route\":\"/insightappsec/scan-configuration\",\"frontMatter\":{\"title\":\"Configure your Scan | Application Security Documentation\",\"excerpt\":\"This article covers how to create, edit, copy, and delete Application Security (InsightAppSec) scan configurations.\",\"filePath\":\"src/content/insightappsec/scan-configuration/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Create a Scan Config\"},{\"name\":\"authentication\",\"route\":\"/insightappsec/authentication\",\"frontMatter\":{\"title\":\"Configure Scan Authentication | Application Security Documentation\",\"excerpt\":\"This article covers how to configure the authentication for your Application Security (InsightAppSec) scan and provides information about each authentication type.\",\"filePath\":\"src/content/insightappsec/authentication/ind