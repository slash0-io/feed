e\":\"/release-notes/insight-agent/20220530\",\"frontMatter\":{\"createdAt\":\"2022-05-30\",\"version\":\"3.1.5.15\",\"description\":\"This release includes improved network connectivity and a security update.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20220530/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20220713\",\"route\":\"/release-notes/insight-agent/20220713\",\"frontMatter\":{\"createdAt\":\"2022-07-13\",\"version\":\"3.1.6\",\"description\":\"This release includes a new Insight Agent component, new data collection for Microsoft Patch Tuesday content for May and June, added fingerprinting for VMware, as well as several improvements and fixes.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20220713/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20220728\",\"route\":\"/release-notes/insight-agent/20220728\",\"frontMatter\":{\"createdAt\":\"2022-07-28\",\"version\":\"3.1.6.44\",\"description\":\"This release contains a fix to log tailing functionality via logging.json.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20220728/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20220818\",\"route\":\"/release-notes/insight-agent/20220818\",\"frontMatter\":{\"createdAt\":\"2022-08-18\",\"version\":\"3.1.6.45\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for July and August 2022 and a few fixes.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20220818/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20220830\",\"route\":\"/release-notes/insight-agent/20220830\",\"frontMatter\":{\"createdAt\":\"2022-08-30\",\"version\":\"3.1.7\",\"description\":\"This release includes a couple of bug fixes.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20220830/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20220912\",\"route\":\"/release-notes/insight-agent/20220912\",\"frontMatter\":{\"createdAt\":\"2022-09-12\",\"version\":\"3.1.8\",\"description\":\"This release includes added Zimbra Collaboration Suite support, improvements, and a few fixes.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20220912/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20220920\",\"route\":\"/release-notes/insight-agent/20220920\",\"frontMatter\":{\"createdAt\":\"2022-09-20\",\"version\":\"3.1.9\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for September 2022.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20220920/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20221021\",\"route\":\"/release-notes/insight-agent/20221021\",\"frontMatter\":{\"createdAt\":\"2022-10-21\",\"version\":\"3.1.10\",\"description\":\"This release includes a new data collection capability to support an Apache Commons Text vulnerability check, Microsoft Patch Tuesday content for October 2022, several additions, an improvement, and a fix.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20221021/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20221026\",\"route\":\"/release-notes/insight-agent/20221026\",\"frontMatter\":{\"createdAt\":\"2022-10-26\",\"description\":\"The Insight Agent now supports Windows 11 22H2.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20221026/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20221102\",\"route\":\"/release-notes/insight-agent/20221102\",\"frontMatter\":{\"createdAt\":\"2022-11-02\",\"version\":\"3.1.10.34\",\"description\":\"This release includes updated support for vulnerability checks affecting OpenSSL and the removal of an unused OpenSSL library.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20221102/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20221103\",\"route\":\"/release-notes/insight-agent/20221103\",\"frontMatter\":{\"createdAt\":\"2022-11-03\",\"version\":\"3.1.10.36\",\"description\":\"This release removes an unused SHA3 library.\",\"title\":\"Other Changes | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20221103/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Other Changes | Rapid7 Agent Documentation\"},{\"name\":\"20221107\",\"route\":\"/release-notes/insight-agent/20221107\",\"frontMatter\":{\"createdAt\":\"2022-11-07\",\"description\":\"The Insight Agent now supports macOS Ventura 13.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20221107/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20221108\",\"route\":\"/release-notes/insight-agent/20221108\",\"frontMatter\":{\"createdAt\":\"2022-11-08\",\"description\":\"Automatic rollout of the Endpoint Broker to InsightVM users to support the upcoming agent-based policy feature.\",\"title\":\"Endpoint Broker Rollout | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20221108/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Endpoint Broker Rollout | Rapid7 Agent Documentation\"},{\"name\":\"20221115\",\"route\":\"/release-notes/insight-agent/20221115\",\"frontMatter\":{\"createdAt\":\"2022-11-15\",\"version\":\"3.1.11\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for November 2022, a fix, and the removal of an unused SHA3 library.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20221115/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20221201\",\"route\":\"/release-notes/insight-agent/20221201\",\"frontMatter\":{\"createdAt\":\"2022-12-01\",\"version\":\"3.1.12\",\"description\":\"This release includes OpenSSL 1.1.1q uplift, an improved backend capability, and a fix.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20221201/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20221208\",\"route\":\"/release-notes/insight-agent/20221208\",\"frontMatter\":{\"createdAt\":\"2022-12-08\",\"version\":\"3.2.0\",\"description\":\"This release includes added support for the AWS Graviton Processor, an improvement, and a bug fix.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20221208/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20221220\",\"route\":\"/release-notes/insight-agent/20221220\",\"frontMatter\":{\"createdAt\":\"2022-12-20\",\"version\":\"3.2.1\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for December 2022.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20221220/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20230111\",\"route\":\"/release-notes/insight-agent/20230111\",\"frontMatter\":{\"createdAt\":\"2023-01-11\",\"version\":\"3.2.2\",\"description\":\"This release enables InsightVM customers to request Windows directory exclusions.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230111/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20230113\",\"route\":\"/release-notes/insight-agent/20230113\",\"frontMatter\":{\"createdAt\":\"2023-01-13\",\"version\":\"3.2.3\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for January 2023.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230113/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20230222\",\"route\":\"/release-notes/insight-agent/20230222\",\"frontMatter\":{\"createdAt\":\"2023-02-22\",\"version\":\"3.2.4\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for February 2023, as well as several improvements and bug fixes.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230222/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20230320\",\"route\":\"/release-notes/insight-agent/20230320\",\"frontMatter\":{\"createdAt\":\"2023-03-20\",\"version\":\"3.2.5\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for March 2023.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230320/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20230323\",\"route\":\"/release-notes/insight-agent/20230323\",\"frontMatter\":{\"createdAt\":\"2023-03-23\",\"description\":\"We improved the automatic update and throttle control settings offered by the Agent Management experience.\",\"title\":\"Improved Update Controls | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230323/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved Update Controls | Rapid7 Agent Documentation\"},{\"name\":\"20230412\",\"route\":\"/release-notes/insight-agent/20230412\",\"frontMatter\":{\"createdAt\":\"2023-04-12\",\"description\":\"You can now adjust the retention period that governs how long Agent Management tracks your Insight Agents.\",\"title\":\"Agent Management Update | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230412/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Agent Management Update | Rapid7 Agent Documentation\"},{\"name\":\"20230414\",\"route\":\"/release-notes/insight-agent/20230414\",\"frontMatter\":{\"createdAt\":\"2023-04-14\",\"version\":\"3.2.6\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for April 2023, new Events Monitor capabilities, and a fix.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230414/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20230425\",\"route\":\"/release-notes/insight-agent/20230425\",\"frontMatter\":{\"createdAt\":\"2023-04-25\",\"version\":\"3.3.0\",\"description\":\"This release remediates a Directory Traversal vulnerability affecting the Insight Agent and updates several dependencies.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230425/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20230517\",\"route\":\"/release-notes/insight-agent/20230517\",\"frontMatter\":{\"createdAt\":\"2023-05-17\",\"version\":\"3.3.1\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for May 2023, fingerprinting updates, and a fix.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230517/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20230615\",\"route\":\"/release-notes/insight-agent/20230615\",\"frontMatter\":{\"createdAt\":\"2023-06-15\",\"description\":\"This release upgrades the Rapid7-managed version of Sysmon to 14.16 on desktop editions of Windows to remediate a privilege elevation vulnerability.\",\"title\":\"Rapid7-Managed Sysmon 14.16 Upgrade Progress | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230615/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Rapid7-Managed Sysmon 14.16 Upgrade Progress | Rapid7 Agent Documentation\"},{\"name\":\"20230616\",\"route\":\"/release-notes/insight-agent/20230616\",\"frontMatter\":{\"createdAt\":\"2023-06-16\",\"version\":\"3.3.2\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for June 2023.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230616/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20230714\",\"route\":\"/release-notes/insight-agent/20230714\",\"frontMatter\":{\"createdAt\":\"2023-07-14\",\"version\":\"3.3.3\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for July 2023, improved fingerprinting, and a Sysmon service update.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230714/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20230808\",\"route\":\"/release-notes/insight-agent/20230808\",\"frontMatter\":{\"createdAt\":\"2023-08-08\",\"description\":\"This release upgrades the Insight Agent's Bootstrap component with a newer edition of the Go programming language.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230808/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20230811\",\"route\":\"/release-notes/insight-agent/20230811\",\"frontMatter\":{\"createdAt\":\"2023-08-11\",\"version\":\"3.3.4\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for August 2023.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230811/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20230823\",\"route\":\"/release-notes/insight-agent/20230823\",\"frontMatter\":{\"createdAt\":\"2023-08-23\",\"version\":\"3.3.5\",\"description\":\"This release includes new and improved log forwarding functionality, several fixes, and additional Sysmon event collection support.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230823/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20230914\",\"route\":\"/release-notes/insight-agent/20230914\",\"frontMatter\":{\"createdAt\":\"2023-09-14\",\"description\":\"This release includes a Sysmon and Events Monitor update.\",\"title\":\"Sysmon and Events Monitor Update | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230914/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Sysmon and Events Monitor Update | Rapid7 Agent Documentation\"},{\"name\":\"20230915\",\"route\":\"/release-notes/insight-agent/20230915\",\"frontMatter\":{\"createdAt\":\"2023-09-15\",\"version\":\"3.3.6\",\"description\":\"This release includes new data collection for Microsoft Patch Tuesday content for September 2023 and an Endpoint Broker improvement.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230915/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20230921\",\"route\":\"/release-notes/insight-agent/20230921\",\"frontMatter\":{\"createdAt\":\"2023-09-21\",\"description\":\"This release includes a macOS operating system support update.\",\"title\":\"macOS Operating System Support Update | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20230921/index.mdx\",\"timestamp\":1783707814950},\"title\":\"macOS Operating System Support Update | Rapid7 Agent Documentation\"},{\"name\":\"20231003\",\"route\":\"/release-notes/insight-agent/20231003\",\"frontMatter\":{\"createdAt\":\"2023-10-03\",\"version\":\"3.3.6.32\",\"description\":\"This release fixes a bug in the Insight Agent's log forwarding functionality.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20231003/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20231017\",\"route\":\"/release-notes/insight-agent/20231017\",\"frontMatter\":{\"createdAt\":\"2023-10-17\",\"version\":\"4.0.0\",\"description\":\"Insight Agent 4.0 provides enhanced endpoint visibility and prevention through the integration of Minerva’s Next-Gen Antivirus with behavioral blocking, advanced digital forensics and response capabilities with Velociraptor, and a new model for InsightVM data collection.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20231017/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20231018\",\"route\":\"/release-notes/insight-agent/20231018\",\"frontMatter\":{\"createdAt\":\"2023-10-18\",\"version\":\"4.0.0.1\",\"description\":\"This release fixes a critical issue in Insight Agent 4.0.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20231018/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20231129\",\"route\":\"/release-notes/insight-agent/20231129\",\"frontMatter\":{\"createdAt\":\"2023-11-29\",\"description\":\"This release upgrades the Sysmon Installer component.\",\"title\":\"Sysmon and Events Monitor Update | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20231129/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Sysmon and Events Monitor Update | Rapid7 Agent Documentation\"},{\"name\":\"20231204\",\"route\":\"/release-notes/insight-agent/20231204\",\"frontMatter\":{\"createdAt\":\"2023-12-04\",\"version\":\"4.0.2\",\"description\":\"This release includes a new file system traversal command for Windows endpoints to scan for vulnerabilities, improvements, several bug fixes, and an update on supported operating systems.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20231204/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20240118\",\"route\":\"/release-notes/insight-agent/20240118\",\"frontMatter\":{\"createdAt\":\"2024-01-18\",\"version\":\"4.0.3\",\"description\":\"This release includes a new method for disabling Insight Agent updates, an improvement, and a fix.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240118/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20240208\",\"route\":\"/release-notes/insight-agent/20240208\",\"frontMatter\":{\"createdAt\":\"2024-02-08\",\"description\":\"This release includes a Velociraptor component update for Insight IDR Ultimate customers.\",\"title\":\"Rapid7 Velociraptor Component Update | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240208/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Rapid7 Velociraptor Component Update | Rapid7 Agent Documentation\"},{\"name\":\"20240213\",\"route\":\"/release-notes/insight-agent/20240213\",\"frontMatter\":{\"createdAt\":\"2024-02-13\",\"version\":\"4.0.4\",\"description\":\"This release includes updates to the Bootstrap and Endpoint Broker components of the Insight Agent.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240213/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20240228\",\"route\":\"/release-notes/insight-agent/20240228\",\"frontMatter\":{\"createdAt\":\"2024-02-28\",\"version\":\"4.0.5\",\"description\":\"This release fixes an asset quarantine issue.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240228/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20240314\",\"route\":\"/release-notes/insight-agent/20240314\",\"frontMatter\":{\"createdAt\":\"2024-03-14\",\"version\":\"4.0.6\",\"description\":\"This release includes an upgrade of the Insight Agent's Python and OpenSSL versions, an improvement, and several defect fixes.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240314/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20240412\",\"route\":\"/release-notes/insight-agent/20240412\",\"frontMatter\":{\"createdAt\":\"2024-04-12\",\"version\":\"4.0.7\",\"description\":\"This release includes an improvement to the Insight Agent and bug fixes for the Bootstrap sub-component of the Agent.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240412/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20240424\",\"route\":\"/release-notes/insight-agent/20240424\",\"frontMatter\":{\"createdAt\":\"2024-04-24\",\"description\":\"This release upgrades the Sysmon Installer component.\",\"title\":\"Sysmon and Events Monitor Update | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240424/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Sysmon and Events Monitor Update | Rapid7 Agent Documentation\"},{\"name\":\"20240425\",\"route\":\"/release-notes/insight-agent/20240425\",\"frontMatter\":{\"createdAt\":\"2024-04-25\",\"description\":\"This release includes a Velociraptor component update for Insight IDR Ultimate and MTC Ultimate customers.\",\"title\":\"Rapid7 Velociraptor Component Update | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240425/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Rapid7 Velociraptor Component Update | Rapid7 Agent Documentation\"},{\"name\":\"20240501\",\"route\":\"/release-notes/insight-agent/20240501\",\"frontMatter\":{\"createdAt\":\"2024-05-01\",\"description\":\"This release fixes an issue with the Sysmon Installer Insight Agent Component.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240501/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20240521\",\"route\":\"/release-notes/insight-agent/20240521\",\"frontMatter\":{\"createdAt\":\"2024-05-21\",\"description\":\"Ransomware Prevention is now available for MTC Ultimate customers\",\"title\":\"Ransomware Prevention for MTC Ultimate | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240521/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Ransomware Prevention for MTC Ultimate | Rapid7 Agent Documentation\"},{\"name\":\"20240528\",\"route\":\"/release-notes/insight-agent/20240528\",\"frontMatter\":{\"createdAt\":\"2024-05-28\",\"version\":\"4.0.8\",\"description\":\"This release includes a new Insight Agent installer experience, added support for the auditd Linux plugin, an updated version of OpenSSL, and a fix.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240528/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20240529\",\"route\":\"/release-notes/insight-agent/20240529\",\"frontMatter\":{\"createdAt\":\"2024-05-29\",\"description\":\"The Insight Agent now supports Windows on ARM for InsightIVM.\",\"title\":\"Windows on ARM Support | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240529/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Windows on ARM Support | Rapid7 Agent Documentation\"},{\"name\":\"20240611\",\"route\":\"/release-notes/insight-agent/20240611\",\"frontMatter\":{\"createdAt\":\"2024-06-11\",\"version\":\"4.0.9\",\"description\":\"This release includes an upgrade of the Insight Agent's Agent Core component and defect fixes.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240611/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20240618\",\"route\":\"/release-notes/insight-agent/20240618\",\"frontMatter\":{\"createdAt\":\"2024-06-18\",\"version\":\"4.0.9.38\",\"description\":\"This release fixes an uninstall issue with the rpm/deb/pkg packages.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240618/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20240626\",\"route\":\"/release-notes/insight-agent/20240626\",\"frontMatter\":{\"createdAt\":\"2024-06-26\",\"description\":\"This release includes a Next-Generation Antivirus (NGAV) add-on update and a policy enhancement.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240626/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20240903\",\"route\":\"/release-notes/insight-agent/20240903\",\"frontMatter\":{\"createdAt\":\"2024-09-03\",\"version\":\"4.0.9.39\",\"description\":\"This release fixes an issue related to event log collection for Windows Server operating systems running on domain controllers.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240903/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20240912\",\"route\":\"/release-notes/insight-agent/20240912\",\"frontMatter\":{\"createdAt\":\"2024-09-12\",\"version\":\"4.0.10\",\"description\":\"This release includes native Windows ARM64 installer support, improved Endpoint Prevention installation, a fix, and updated support.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20240912/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20241008\",\"route\":\"/release-notes/insight-agent/20241008\",\"frontMatter\":{\"createdAt\":\"2024-10-08\",\"description\":\"The Rapid7 Velociraptor component is now automatically deployed to MDR customers.\",\"title\":\"Rapid7 Velociraptor component update | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20241008/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Rapid7 Velociraptor component update | Rapid7 Agent Documentation\"},{\"name\":\"20241009\",\"route\":\"/release-notes/insight-agent/20241009\",\"frontMatter\":{\"createdAt\":\"2024-10-09\",\"version\":\"4.0.11\",\"description\":\"This release includes log collection updates, a fix to improve security posture, and a supported operating systems update.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20241009/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20241010\",\"route\":\"/release-notes/insight-agent/20241010\",\"frontMatter\":{\"createdAt\":\"2024-10-10\",\"description\":\"This release extends the Next-Generation Antivirus add-on support beyond Windows operating systems, adding protection capabilities for macOS and Linux operating systems.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20241010/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20241021\",\"route\":\"/release-notes/insight-agent/20241021\",\"frontMatter\":{\"createdAt\":\"2024-10-21\",\"version\":\"4.0.12\",\"description\":\"This release includes macOS 15 Sequoia support.\",\"title\":\"macOS Operating System Support Update | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20241021/index.mdx\",\"timestamp\":1783707814950},\"title\":\"macOS Operating System Support Update | Rapid7 Agent Documentation\"},{\"name\":\"20241126\",\"route\":\"/release-notes/insight-agent/20241126\",\"frontMatter\":{\"createdAt\":\"2024-11-26\",\"version\":\"4.0.13\",\"description\":\"This release includes an improved command to search for vulnerabilities local Windows file systems, added support for Windows 11 24h2, and a few bug fixes.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20241126/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20241206\",\"route\":\"/release-notes/insight-agent/20241206\",\"frontMatter\":{\"createdAt\":\"2024-12-06\",\"version\":\"4.0.13.32\",\"description\":\"This release fixes a bug in the Insight Agent's log forwarding functionality.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20241206/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20250206\",\"route\":\"/release-notes/insight-agent/20250206\",\"frontMatter\":{\"createdAt\":\"2025-02-06\",\"version\":\"4.0.14\",\"description\":\"This release includes several bug fixes including an upgrade from a vulnerable third-party Python library.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250206/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20250226\",\"route\":\"/release-notes/insight-agent/20250226\",\"frontMatter\":{\"createdAt\":\"2025-02-26\",\"description\":\"This release improves the Next-Generation Antivirus add-on installation procedure for Windows OS and fixes performance related issues and bugs across Windows, macOS and Linux.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250226/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20250312\",\"route\":\"/release-notes/insight-agent/20250312\",\"frontMatter\":{\"createdAt\":\"2025-03-12\",\"version\":\"4.0.15\",\"description\":\"This release is no longer available for download. Refer to the March 13, 2025 release notes for more information.\",\"title\":\"release-notes-4.0.15 | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250312/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-4.0.15 | Rapid7 Agent Documentation\"},{\"name\":\"20250313\",\"route\":\"/release-notes/insight-agent/20250313\",\"frontMatter\":{\"createdAt\":\"2025-03-13\",\"description\":\"Due to an issue released in version 4.0.15, the Insight Agent has been rolled back to version 4.0.14.\",\"title\":\"Known Issue | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250313/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Known Issue | Rapid7 Agent Documentation\"},{\"name\":\"20250314\",\"route\":\"/release-notes/insight-agent/20250314\",\"frontMatter\":{\"createdAt\":\"2025-03-14\",\"version\":\"4.0.15.31\",\"description\":\"This release addresses the issue in Insight Agent version 4.0.15 that caused delays in a small number of InsightVM vulnerability assessments, and restores its other changes.\",\"title\":\"release-notes-4.0.15.31 | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250314/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-4.0.15.31 | Rapid7 Agent Documentation\"},{\"name\":\"20250407\",\"route\":\"/release-notes/insight-agent/20250407\",\"frontMatter\":{\"createdAt\":\"2025-04-07\",\"version\":\"4.0.16\",\"description\":\"This release upgrades vulnerable versions of third-party libraries and fixes a bug on macOS arm64 installations.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250407/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20250423\",\"route\":\"/release-notes/insight-agent/20250423\",\"frontMatter\":{\"createdAt\":\"2025-04-23\",\"version\":\"4.0.16.27\",\"description\":\"This release includes new data collection supporting CrushFTP vulnerability checks.\",\"title\":\"New | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250423/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Rapid7 Agent Documentation\"},{\"name\":\"20250513\",\"route\":\"/release-notes/insight-agent/20250513\",\"frontMatter\":{\"createdAt\":\"2025-05-13\",\"version\":\"4.0.17.21\",\"description\":\"This release includes an improvement to process start event details, a few fixes, and an update regarding the type of operating system architecture supported by the Insight Agent.\",\"title\":\"release-notes-4.0.17 | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250513/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-4.0.17 | Rapid7 Agent Documentation\"},{\"name\":\"20250604\",\"route\":\"/release-notes/insight-agent/20250604\",\"frontMatter\":{\"createdAt\":\"2025-06-04\",\"version\":\"\",\"description\":\"We’ve released version 1.3.4 of the Next-Generation Antivirus (NGAV) add-on for Windows, which includes fixes for a couple of key issues affecting performance and integration.\",\"title\":\"Fixed | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250604/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Rapid7 Agent Documentation\"},{\"name\":\"20250609\",\"route\":\"/release-notes/insight-agent/20250609\",\"frontMatter\":{\"createdAt\":\"2025-06-09\",\"description\":\"We've upgraded Hosted Velociraptor to version 0.74.  This upgrade includes new features, improvements, and fixes across the Insight Agent and Hosted Velociraptor components.\",\"title\":\"General Updates | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250609/index.mdx\",\"timestamp\":1783707814950},\"title\":\"General Updates | Rapid7 Agent Documentation\"},{\"name\":\"20250621\",\"route\":\"/release-notes/insight-agent/20250621\",\"frontMatter\":{\"createdAt\":\"2025-06-21\",\"version\":\"\",\"description\":\"Next Generation Antivirus 2.1.2 release notes\",\"title\":\"release-notes-ngav-2.1.2 | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250621/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-ngav-2.1.2 | Rapid7 Agent Documentation\"},{\"name\":\"20250730\",\"route\":\"/release-notes/insight-agent/20250730\",\"frontMatter\":{\"createdAt\":\"2025-07-30\",\"version\":\"4.0.18.46\",\"description\":\"This release includes an OpenSSL upgrade for FedRAMP versions of the Insight Agent, upgrades to other Python libraries, support for new data regions, and bug fixes.  It also ends support for CentOS 7.\",\"title\":\"Improved | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250730/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Rapid7 Agent Documentation\"},{\"name\":\"20250814\",\"route\":\"/release-notes/insight-agent/20250814\",\"frontMatter\":{\"createdAt\":\"2025-08-14\",\"description\":\"You can now create multiple test sets to control Insight Agent update behavior across different endpoint configurations in your environment.\",\"title\":\"Improved Insight Agent Test Set Experience | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250814/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved Insight Agent Test Set Experience | Rapid7 Agent Documentation\"},{\"name\":\"20250904\",\"route\":\"/release-notes/insight-agent/20250904\",\"frontMatter\":{\"createdAt\":\"2025-09-04\",\"description\":\"This document is no longer updated as of Sep 4, 2025. Read new release notes in the Command Platform Help.\",\"title\":\"agent-release-notes-eol | Rapid7 Agent Documentation\",\"filePath\":\"src/content/release-notes/insight-agent/20250904/index.mdx\",\"timestamp\":1783707814950},\"title\":\"agent-release-notes-eol | Rapid7 Agent Documentation\"},{\"name\":\"page\",\"route\":\"/release-notes/insight-agent/page\",\"children\":[{\"name\":\"10\",\"route\":\"/release-notes/insight-agent/page/10\",\"frontMatter\":{\"title\":\"Rapid7 Agent Release Notes - Page 10\",\"description\":\"Release notes for Rapid7 Agent - Page 10\"},\"title\":\"Rapid7 Agent Release Notes - Page 10\"},{\"name\":\"11\",\"route\":\"/release-notes/insight-agent/page/11\",\"frontMatter\":{\"title\":\"Rapid7 Agent Release Notes - Page 11\",\"description\":\"Release notes for Rapid7 Agent - Page 11\"},\"title\":\"Rapid7 Agent Release Notes - Page 11\"},{\"name\":\"2\",\"route\":\"/release-notes/insight-agent/page/2\",\"frontMatter\":{\"title\":\"Rapid7 Agent Release Notes - Page 2\",\"description\":\"Release notes for Rapid7 Agent - Page 2\"},\"title\":\"Rapid7 Agent Release Notes - Page 2\"},{\"name\":\"3\",\"route\":\"/release-notes/insight-agent/page/3\",\"frontMatter\":{\"title\":\"Rapid7 Agent Release Notes - Page 3\",\"description\":\"Release notes for Rapid7 Agent - Page 3\"},\"title\":\"Rapid7 Agent Release Notes - Page 3\"},{\"name\":\"4\",\"route\":\"/release-notes/insight-agent/page/4\",\"frontMatter\":{\"title\":\"Rapid7 Agent Release Notes - Page 4\",\"description\":\"Release notes for Rapid7 Agent - Page 4\"},\"title\":\"Rapid7 Agent Release Notes - Page 4\"},{\"name\":\"5\",\"route\":\"/release-notes/insight-agent/page/5\",\"frontMatter\":{\"title\":\"Rapid7 Agent Release Notes - Page 5\",\"description\":\"Release notes for Rapid7 Agent - Page 5\"},\"title\":\"Rapid7 Agent Release Notes - Page 5\"},{\"name\":\"6\",\"route\":\"/release-notes/insight-agent/page/6\",\"frontMatter\":{\"title\":\"Rapid7 Agent Release Notes - Page 6\",\"description\":\"Release notes for Rapid7 Agent - Page 6\"},\"title\":\"Rapid7 Agent Release Notes - Page 6\"},{\"name\":\"7\",\"route\":\"/release-notes/insight-agent/page/7\",\"frontMatter\":{\"title\":\"Rapid7 Agent Release Notes - Page 7\",\"description\":\"Release notes for Rapid7 Agent - Page 7\"},\"title\":\"Rapid7 Agent Release Notes - Page 7\"},{\"name\":\"8\",\"route\":\"/release-notes/insight-agent/page/8\",\"frontMatter\":{\"title\":\"Rapid7 Agent Release Notes - Page 8\",\"description\":\"Release notes for Rapid7 Agent - Page 8\"},\"title\":\"Rapid7 Agent Release Notes - Page 8\"},{\"name\":\"9\",\"route\":\"/release-notes/insight-agent/page/9\",\"frontMatter\":{\"title\":\"Rapid7 Agent Release Notes - Page 9\",\"description\":\"Release notes for Rapid7 Agent - Page 9\"},\"title\":\"Rapid7 Agent Release Notes - Page 9\"}],\"title\":\"Page\"}],\"title\":\"Insight Agent\"},{\"name\":\"insightappsec\",\"route\":\"/release-notes/insightappsec\",\"children\":[{\"name\":\"index\",\"route\":\"/release-notes/insightappsec\",\"frontMatter\":{\"title\":\"Application Security Release Notes - Page 1\",\"description\":\"Release notes for Application Security - Page 1\"},\"title\":\"Application Security Release Notes - Page 1\"},{\"name\":\"20201023\",\"route\":\"/release-notes/insightappsec/20201023\",\"frontMatter\":{\"createdAt\":\"2020-10-23\",\"version\":\"2020.10.23\",\"description\":\"We released a new version of the scan engine, and made it easier to share specific vulnerabilities with other InsightAppSec users.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20201023/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20201110\",\"route\":\"/release-notes/insightappsec/20201110\",\"frontMatter\":{\"createdAt\":\"2020-11-10\",\"version\":\"2020.11.10\",\"description\":\"This release fixes several interface and feature-related bugs.\",\"title\":\"Fixed | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20201110/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | Application Security Documentation\"},{\"name\":\"20201207\",\"route\":\"/release-notes/insightappsec/20201207\",\"frontMatter\":{\"createdAt\":\"2020-12-07\",\"version\":\"2020.12.07\",\"description\":\"We released the application tagging feature, the Last Discovered date for vulnerabilities, a new report type, and bug fixes.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20201207/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20210104\",\"route\":\"/release-notes/insightappsec/20210104\",\"frontMatter\":{\"createdAt\":\"2021-01-04\",\"version\":\"2021.01.04\",\"description\":\"We released Global Schedules, moved and added more options to App Files, changed Whitelist to Allowlist, and fixed bugs.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20210104/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20210201\",\"route\":\"/release-notes/insightappsec/20210201\",\"frontMatter\":{\"createdAt\":\"2021-02-01\",\"version\":\"2021.02.01\",\"description\":\"We released new Public API endpoints, a new crawling option, data drill-down capability for two chart types, and fixed interface and feature-related bugs.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20210201/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20210301\",\"route\":\"/release-notes/insightappsec/20210301\",\"frontMatter\":{\"createdAt\":\"2021-03-01\",\"version\":\"2021.03.01\",\"description\":\"We released new and updated features to improve screen space, upgraded the scan engine, and fixed a couple interface bugs.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20210301/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20210507\",\"route\":\"/release-notes/insightappsec/20210507\",\"frontMatter\":{\"createdAt\":\"2021-05-07\",\"version\":\"2021.05.07\",\"description\":\"We released the ability to add sub domains to the allowlist, updated features to improve the UI, and fixed some bugs.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20210507/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20210621\",\"route\":\"/release-notes/insightappsec/20210621\",\"frontMatter\":{\"createdAt\":\"2021-06-21\",\"version\":\"2021.06.21\",\"description\":\"We added the ability to scan only new and updated code and tag management from the API. We updated and fixed features to improve the functionality and UI.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20210621/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20210719\",\"route\":\"/release-notes/insightappsec/20210719\",\"frontMatter\":{\"createdAt\":\"2021-07-19\",\"version\":\"07.19.2021\",\"description\":\"This release includes new and improved functionality, as well as a few bug fixes.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20210719/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20210816\",\"route\":\"/release-notes/insightappsec/20210816\",\"frontMatter\":{\"createdAt\":\"2021-08-16\",\"version\":\"2021.08.16\",\"description\":\"This release includes new API endpoints, an improved version of the scan engine, and several fixes.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20210816/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20210915\",\"route\":\"/release-notes/insightappsec/20210915\",\"frontMatter\":{\"createdAt\":\"2021-09-15\",\"version\":\"2021.09.15\",\"description\":\"We added CVSS 3.1 scores and the ability to test login credentials, a new way to test remediation, and improved how you enable scan authentication.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20210915/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20211011\",\"route\":\"/release-notes/insightappsec/20211011\",\"frontMatter\":{\"createdAt\":\"2021-10-11\",\"version\":\"2021.10.11\",\"description\":\"This release includes a few improvements and a couple of fixes.\",\"title\":\"Improved | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20211011/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Application Security Documentation\"},{\"name\":\"20211108\",\"route\":\"/release-notes/insightappsec/20211108\",\"frontMatter\":{\"createdAt\":\"2021-11-08\",\"version\":\"2021.11.08\",\"description\":\"We added the ability to archive scanned targets, made some improvements to canceling queued scans and using the API to get a direct vulnerability link, as well as some bug fixes.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20211108/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20211206\",\"route\":\"/release-notes/insightappsec/20211206\",\"frontMatter\":{\"createdAt\":\"2021-12-06\",\"version\":\"2021.12.06\",\"description\":\"This release includes the ability to export vulnerabilities to ServiceNow ITSM, a few improvements, and several bug fixes.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20211206/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20211222\",\"route\":\"/release-notes/insightappsec/20211222\",\"frontMatter\":{\"createdAt\":\"2021-12-22\",\"version\":\"2021.12.22\",\"description\":\"This release includes a new Out of Band Injection attack module to detect Log4Shell vulnerabilities.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20211222/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20220131\",\"route\":\"/release-notes/insightappsec/20220131\",\"frontMatter\":{\"createdAt\":\"2022-01-31\",\"version\":\"2022.01.31\",\"description\":\"This release includes a new CSV exporting option, a couple of improvements, and several fixes.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20220131/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20220228\",\"route\":\"/release-notes/insightappsec/20220228\",\"frontMatter\":{\"createdAt\":\"2022-02-28\",\"version\":\"2022.02.28\",\"description\":\"This release includes app-level filtering for dashboards, a new scan reporting option, and a few bug fixes.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20220228/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20220328\",\"route\":\"/release-notes/insightappsec/20220328\",\"frontMatter\":{\"createdAt\":\"2022-03-28\",\"version\":\"2022.03.28\",\"description\":\"This release includes Gitlab extensions, new reporting capabilities, a new dashboard card, and several fixes.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20220328/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20220401\",\"route\":\"/release-notes/insightappsec/20220401\",\"frontMatter\":{\"createdAt\":\"2022-04-01\",\"version\":\"2022.04.01\",\"description\":\"This release includes an updated RCE attack module to detect the Spring4Shell vulnerability, improved login detection, and several fixes.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20220401/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20220425\",\"route\":\"/release-notes/insightappsec/20220425\",\"frontMatter\":{\"createdAt\":\"2022-04-25\",\"version\":\"2022.04.25\",\"description\":\"This release includes updates to the scan engine version, vulnerability export, several bug fixes, and a few UI improvements.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20220425/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20220523\",\"route\":\"/release-notes/insightappsec/20220523\",\"frontMatter\":{\"createdAt\":\"2022-05-23\",\"version\":\"2022.05.23\",\"description\":\"This release includes a new feature for managing columns in Vulnerabilities, several bug fixes, and a few UI improvements. \",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20220523/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20220620\",\"route\":\"/release-notes/insightappsec/20220620\",\"frontMatter\":{\"createdAt\":\"2022-06-20\",\"version\":\"2022.06.20\",\"description\":\"This release includes a new server authentication method, as well as various bug fixes.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20220620/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20220718\",\"route\":\"/release-notes/insightappsec/20220718\",\"frontMatter\":{\"createdAt\":\"2022-07-18\",\"version\":\"2022.07.18\",\"description\":\"This release includes a new version of the scan engine and various updates.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20220718/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20220815\",\"route\":\"/release-notes/insightappsec/20220815\",\"frontMatter\":{\"createdAt\":\"2022-08-15\",\"version\":\"2022.08.15\",\"description\":\"This release includes Target Discovery and CVSS v3.1 scores.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20220815/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20220912\",\"route\":\"/release-notes/insightappsec/20220912\",\"frontMatter\":{\"createdAt\":\"2022-09-12\",\"version\":\"2022.09.12\",\"description\":\"This release includes YAML for scanning APIs, as well as a fix related to the dashboard filter.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20220912/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20221010\",\"route\":\"/release-notes/insightappsec/20221010\",\"frontMatter\":{\"createdAt\":\"2022-10-10\",\"version\":\"2022.10.10\",\"description\":\"Our recent releases include a new version of the scan engine, as well as an improvement to reports. \",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20221010/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20221107\",\"route\":\"/release-notes/insightappsec/20221107\",\"frontMatter\":{\"createdAt\":\"2022-11-07\",\"version\":\"2022.11.07\",\"description\":\"Our recent releases include webhooks and a new version of the scan engine.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20221107/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20221205\",\"route\":\"/release-notes/insightappsec/20221205\",\"frontMatter\":{\"createdAt\":\"2022-12-05\",\"version\":\"2022.12.05\",\"description\":\"Our recent releases include a new version of the scan engine and webhook for failed scans.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20221205/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20230130\",\"route\":\"/release-notes/insightappsec/20230130\",\"frontMatter\":{\"createdAt\":\"2023-01-30\",\"version\":\"2023.01.30\",\"description\":\"Our recent releases include an improvement to webhooks.\",\"title\":\"Improved | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20230130/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | Application Security Documentation\"},{\"name\":\"20230223\",\"route\":\"/release-notes/insightappsec/20230223\",\"frontMatter\":{\"createdAt\":\"2023-02-23\",\"version\":\"2023.02.23\",\"description\":\"Our recent release includes a new version of the scan engine.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20230223/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20230327\",\"route\":\"/release-notes/insightappsec/20230327\",\"frontMatter\":{\"createdAt\":\"2023-03-27\",\"version\":\"2023.03.27\",\"description\":\"Our recent releases include Slack and Teams webhooks, as well as an improvement to macros.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20230327/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20230605\",\"route\":\"/release-notes/insightappsec/20230605\",\"frontMatter\":{\"createdAt\":\"2023-06-05\",\"version\":\"2023.06.05\",\"description\":\"Our recent releases include live vulnerabilities, a new All API modules attack template, an OWASP API security risks Top 10 report, as well as various improvements.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20230605/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20230804\",\"route\":\"/release-notes/insightappsec/20230804\",\"frontMatter\":{\"createdAt\":\"2023-08-04\",\"version\":\"2023.08.04\",\"description\":\"Our recent release includes a new version of the scan engine.\",\"title\":\"New | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20230804/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Application Security Documentation\"},{\"name\":\"20231211\",\"route\":\"/release-notes/insightappsec/20231211\",\"frontMatter\":{\"createdAt\":\"2023-12-11\",\"version\":\"2023.12.11\",\"description\":\"7.5 Scan Engine release notes round-up\",\"title\":\"release-notes-2023.12.11 | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20231211/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-2023.12.11 | Application Security Documentation\"},{\"name\":\"20231212\",\"route\":\"/release-notes/insightappsec/20231212\",\"frontMatter\":{\"createdAt\":\"2023-12-12\",\"version\":\"2023.12.12\",\"description\":\"This release includes various improvements and updates to the Scan Engine.\",\"title\":\"7.5.005 | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20231212/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.005 | Application Security Documentation\"},{\"name\":\"20240315\",\"route\":\"/release-notes/insightappsec/20240315\",\"frontMatter\":{\"createdAt\":\"2024-03-15\",\"version\":\"2024.03.15\",\"description\":\"This release includes various improvements and updates to the Scan Engine.\",\"title\":\"release-notes-2024.03.15 | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20240315/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-2024.03.15 | Application Security Documentation\"},{\"name\":\"20240426\",\"route\":\"/release-notes/insightappsec/20240426\",\"frontMatter\":{\"createdAt\":\"2024-04-26\",\"version\":\"2024.04.26\",\"description\":\"This release includes various updates and improvements to the Scan Engine.\",\"title\":\"release-notes-2024.04.26 | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20240426/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-2024.04.26 | Application Security Documentation\"},{\"name\":\"20240710\",\"route\":\"/release-notes/insightappsec/20240710\",\"frontMatter\":{\"createdAt\":\"2024-07-10\",\"version\":\"2024.07.10\",\"description\":\"This is a round-up of the recent Scan Engine 7.5 updates and fixes.\",\"title\":\"7.5.010 (released June 10, 2024) | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20240710/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.010 (released June 10, 2024) | Application Security Documentation\"},{\"name\":\"20240924\",\"route\":\"/release-notes/insightappsec/20240924\",\"frontMatter\":{\"createdAt\":\"2024-09-24\",\"version\":\"2024.09.24\",\"description\":\"This engine release includes new payload to the Information Disclosure module, the inclusion of ALF traffic in the traffic metadata log, as well as various improvements and fixes.\",\"title\":\"7.5.011 (released August 20, 2024) | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20240924/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.011 (released August 20, 2024) | Application Security Documentation\"},{\"name\":\"20240930\",\"route\":\"/release-notes/insightappsec/20240930\",\"frontMatter\":{\"createdAt\":\"2024-09-30\",\"version\":\"2024.09.30\",\"description\":\"This engine release includes enhancements to the Information Disclosure module, the XSS_DOM attack, Passive attacks, and PCI, as well as various improvements and fixes.\",\"title\":\"7.5.012 (released September 26, 2024) | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20240930/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.012 (released September 26, 2024) | Application Security Documentation\"},{\"name\":\"20241031\",\"route\":\"/release-notes/insightappsec/20241031\",\"frontMatter\":{\"createdAt\":\"2024-10-31\",\"version\":\"2024.10.31\",\"description\":\"This engine release includes enhancements to the HTTP Headers, the X-Powered-By HTTP Header and Server Configuration modules. It also includes Macro playback improvements, as well as various improvements and fixes for Automated Login Finder (ALF).\",\"title\":\"7.5.013 (released October 31, 2024) | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20241031/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.013 (released October 31, 2024) | Application Security Documentation\"},{\"name\":\"20241128\",\"route\":\"/release-notes/insightappsec/20241128\",\"frontMatter\":{\"createdAt\":\"2024-11-28\",\"version\":\"2024.11.28\",\"description\":\"This engine release includes enhancements to the XSS severity when Content-Type is application/json. It also includes R7Crawler improvements, as well as various improvements and fixes for Automated Login Finder (ALF).\",\"title\":\"7.5.014 (released November 28, 2024) | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20241128/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.014 (released November 28, 2024) | Application Security Documentation\"},{\"name\":\"20250130\",\"route\":\"/release-notes/insightappsec/20250130\",\"frontMatter\":{\"createdAt\":\"2025-01-30\",\"version\":\"2025.01.30\",\"description\":\"This engine release includes enhancements to the BSQL Injection, File Inclusion and SSL Strength Modules. It also includes various R7Crawler and ChromeHost improvements.\",\"title\":\"7.5.015 (released January 30, 2025) | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20250130/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.015 (released January 30, 2025) | Application Security Documentation\"},{\"name\":\"20250310\",\"route\":\"/release-notes/insightappsec/20250310\",\"frontMatter\":{\"createdAt\":\"2025-03-10\",\"version\":\"2025.03.10\",\"description\":\"This engine release includes Macro based HOTP/TOTP Authentication, enhancements to the SSL Strength and Swagger UI DOM Based attack modules. In addition, we have added enhanced Proxy support capabilities. It also includes various R7Crawler and ChromeHost improvements.\",\"title\":\"7.5.016 (released March 10, 2025) | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20250310/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.016 (released March 10, 2025) | Application Security Documentation\"},{\"name\":\"20250516\",\"route\":\"/release-notes/insightappsec/20250516\",\"frontMatter\":{\"createdAt\":\"2025-05-16\",\"version\":\"2025.05.16\",\"description\":\"Enhancements to crawling/scanning with R7Crawler improvements including technology analysis, Chromium integration, and macro headers. Scan engine stability and responsiveness improvements. OTP support in ChromeHost macros. Password exposure check enhancements, NodeJS update, report config options, PCI 4.0 mapping, CSP meta tag handling, and ChromeDriver upgrade.\",\"title\":\"7.5.018 (Released May 16, 2025) | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20250516/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.018 (Released May 16, 2025) | Application Security Documentation\"},{\"name\":\"20250523\",\"route\":\"/release-notes/insightappsec/20250523\",\"frontMatter\":{\"createdAt\":\"2025-05-23\",\"description\":\"This document is no longer updated as of May 23, 2025. Read new release notes in the Command Platform Help.\",\"title\":\"release-notes-ias-eol-notice | Application Security Documentation\",\"filePath\":\"src/content/release-notes/insightappsec/20250523/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-ias-eol-notice | Application Security Documentation\"},{\"name\":\"page\",\"route\":\"/release-notes/insightappsec/page\",\"children\":[{\"name\":\"2\",\"route\":\"/release-notes/insightappsec/page/2\",\"frontMatter\":{\"title\":\"Application Security Release Notes - Page 2\",\"description\":\"Release notes for Application Security - Page 2\"},\"title\":\"Application Security Release Notes - Page 2\"},{\"name\":\"3\",\"route\":\"/release-notes/insightappsec/page/3\",\"frontMatter\":{\"title\":\"Application Security Release Notes - Page 3\",\"description\":\"Release notes for Application Security - Page 3\"},\"title\":\"Application Security Release Notes - Page 3\"},{\"name\":\"4\",\"route\":\"/release-notes/insightappsec/page/4\",\"frontMatter\":{\"title\":\"Application Security Release Notes - Page 4\",\"description\":\"Release notes for Application Security - Page 4\"},\"title\":\"Application Security Release Notes - Page 4\"},{\"name\":\"5\",\"route\":\"/release-notes/insightappsec/page/5\",\"frontMatter\":{\"title\":\"Application Security Release Notes - Page 5\",\"description\":\"Release notes for Application Security - Page 5\"},\"title\":\"Application Security Release Notes - Page 5\"}],\"title\":\"Page\"}],\"title\":\"Insightappsec\"},{\"name\":\"insightcloudsec\",\"route\":\"/release-notes/insightcloudsec\",\"children\":[{\"name\":\"index\",\"route\":\"/release-notes/insightcloudsec\",\"frontMatter\":{\"title\":\"Cloud Security Release Notes - Page 1\",\"description\":\"Release notes for Cloud Security - Page 1\"},\"title\":\"Cloud Security Release Notes - Page 1\"},{\"name\":\"20170124\",\"route\":\"/release-notes/insightcloudsec/20170124\",\"frontMatter\":{\"title\":\"16.08 Release Notes | Cloud Security Documentation\",\"slug\":\"1608-release-notes\",\"type\":\"deprecated\",\"createdAt\":\"2017-01-24T19:18:00.000Z\",\"hidde