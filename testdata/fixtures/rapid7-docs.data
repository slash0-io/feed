tter\":{\"title\":\"Nexpose Release Notes - Page 3\",\"description\":\"Release notes for Nexpose - Page 3\"},\"title\":\"Nexpose Release Notes - Page 3\"},{\"name\":\"4\",\"route\":\"/release-notes/nexpose/page/4\",\"frontMatter\":{\"title\":\"Nexpose Release Notes - Page 4\",\"description\":\"Release notes for Nexpose - Page 4\"},\"title\":\"Nexpose Release Notes - Page 4\"},{\"name\":\"5\",\"route\":\"/release-notes/nexpose/page/5\",\"frontMatter\":{\"title\":\"Nexpose Release Notes - Page 5\",\"description\":\"Release notes for Nexpose - Page 5\"},\"title\":\"Nexpose Release Notes - Page 5\"},{\"name\":\"6\",\"route\":\"/release-notes/nexpose/page/6\",\"frontMatter\":{\"title\":\"Nexpose Release Notes - Page 6\",\"description\":\"Release notes for Nexpose - Page 6\"},\"title\":\"Nexpose Release Notes - Page 6\"},{\"name\":\"7\",\"route\":\"/release-notes/nexpose/page/7\",\"frontMatter\":{\"title\":\"Nexpose Release Notes - Page 7\",\"description\":\"Release notes for Nexpose - Page 7\"},\"title\":\"Nexpose Release Notes - Page 7\"},{\"name\":\"8\",\"route\":\"/release-notes/nexpose/page/8\",\"frontMatter\":{\"title\":\"Nexpose Release Notes - Page 8\",\"description\":\"Release notes for Nexpose - Page 8\"},\"title\":\"Nexpose Release Notes - Page 8\"},{\"name\":\"9\",\"route\":\"/release-notes/nexpose/page/9\",\"frontMatter\":{\"title\":\"Nexpose Release Notes - Page 9\",\"description\":\"Release notes for Nexpose - Page 9\"},\"title\":\"Nexpose Release Notes - Page 9\"}],\"title\":\"Page\"}],\"title\":\"Nexpose\"},{\"name\":\"threat-command\",\"route\":\"/release-notes/threat-command\",\"children\":[{\"name\":\"index\",\"route\":\"/release-notes/threat-command\",\"frontMatter\":{\"title\":\"Digital Risk Protection Release Notes - Page 1\",\"description\":\"Release notes for Digital Risk Protection - Page 1\"},\"title\":\"Digital Risk Protection Release Notes - Page 1\"},{\"name\":\"20230418\",\"route\":\"/release-notes/threat-command/20230418\",\"frontMatter\":{\"createdAt\":\"2023-04-18\",\"description\":\"This release includes faster alert data display, a new system state report column, easier case creation, VRA integration visibility, and more.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20230418/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20230516\",\"route\":\"/release-notes/threat-command/20230516\",\"frontMatter\":{\"createdAt\":\"2023-05-16\",\"description\":\"This release includes a new scan date field for SSL certificate threats, improved phishing website detection accuracy, fewer FP on domain alerts, Qualys integration permanent IP address, fixes, and more.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20230516/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20230530\",\"route\":\"/release-notes/threat-command/20230530\",\"frontMatter\":{\"createdAt\":\"2023-05-30\",\"description\":\"This release includes fewer FP alerts for parked domains, improved phishing website coverage and phishing domain detection, AD continuous integration, fixes, and more.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20230530/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20230620\",\"route\":\"/release-notes/threat-command/20230620\",\"frontMatter\":{\"createdAt\":\"2023-06-20\",\"description\":\"This release includes a new IOC popover, improved remediation status, earlier vulnerability reporting, a new version of the QRadar app, fixes, and more.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20230620/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20230711\",\"route\":\"/release-notes/threat-command/20230711\",\"frontMatter\":{\"createdAt\":\"2023-07-11\",\"description\":\"This release includes the reason for asset suggestion, improved subdomain detection and phishing alerts, filtering IOCs page by file hash type, and more.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20230711/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20230801\",\"route\":\"/release-notes/threat-command/20230801\",\"frontMatter\":{\"createdAt\":\"2023-08-01\",\"description\":\"This release includes improved analysis accuracy of Confidential Documents alerts, a new version (2.4.0) of the IntSights Splunk App, and the renewed Office 365 Integration.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20230801/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20230822\",\"route\":\"/release-notes/threat-command/20230822\",\"frontMatter\":{\"createdAt\":\"2023-08-22\",\"description\":\"This release provides improved analysis accuracy of Asset Mention alerts and a new version of the 'Add New MSSP Customer' API route.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20230822/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20230912\",\"route\":\"/release-notes/threat-command/20230912\",\"frontMatter\":{\"createdAt\":\"2023-09-12\",\"description\":\"This release provides aggregation of Asset mention alerts, the addition of the closing reason in the Alerts API, and performance improvements.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20230912/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20231003\",\"route\":\"/release-notes/threat-command/20231003\",\"frontMatter\":{\"createdAt\":\"2023-10-03\",\"description\":\"This release provides adding a note to multiple alerts, subdomain discovery improvements, and the disabling of IntSights SSO for migrated customers.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20231003/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20231024\",\"route\":\"/release-notes/threat-command/20231024\",\"frontMatter\":{\"createdAt\":\"2023-10-24\",\"description\":\"This release provides faster, automatic alerts for breach or ransomware leaks, alerts for lookalike domains, a new ServiceNow SIR app, confidential documents degradation, attributes for policy emails, and FireEye Intelligence/Mandiant TIP source changes.\",\"title\":\"release-notes-20231003 | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20231024/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-20231003 | Digital Risk Protection Documentation\"},{\"name\":\"20231114\",\"route\":\"/release-notes/threat-command/20231114\",\"frontMatter\":{\"createdAt\":\"2023-11-14\",\"description\":\"This release provides the migration of the Help to the Rapid7 Docs site, disabling of IntSights SSO for migrated customers, and new VRA sorting and filtering options.\",\"title\":\"Platform | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20231114/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Platform | Digital Risk Protection Documentation\"},{\"name\":\"20231205\",\"route\":\"/release-notes/threat-command/20231205\",\"frontMatter\":{\"createdAt\":\"2023-12-05\",\"description\":\"This release provides a new release of the IBM QRadar external app, tag filtering for VRA affected hosts, direct help links from inside Threat Command, and an added title attribute for policy emails.\",\"title\":\"Integration | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20231205/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Integration | Digital Risk Protection Documentation\"},{\"name\":\"20240228\",\"route\":\"/release-notes/threat-command/20240228\",\"frontMatter\":{\"createdAt\":\"2024-02-28\",\"description\":\"This release provides a new Trusted Source, a new Darkweb source, InsightVM multi-tenancy support, password encryption, as well as an improvement to scraping infrastructure.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20240228/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20240521\",\"route\":\"/release-notes/threat-command/20240521\",\"frontMatter\":{\"createdAt\":\"2024-05-21\",\"description\":\"This release provides a new Darkweb source, a policy rule for Botnets type alerts, as well as various improvements and fixes.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20240521/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20240613\",\"route\":\"/release-notes/threat-command/20240613\",\"frontMatter\":{\"createdAt\":\"2024-06-13\",\"description\":\"This release provides additional support from our remediation services, auto-enabled terms of service, new Ransomware-Blog-Scraper sources, as well as various fixes.\",\"title\":\"Threat Command | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20240613/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Threat Command | Digital Risk Protection Documentation\"},{\"name\":\"20250523\",\"route\":\"/release-notes/threat-command/20250523\",\"frontMatter\":{\"createdAt\":\"2025-05-23\",\"description\":\"This document is no longer updated as of May 23, 2025. Read new release notes in the Command Platform Help.\",\"title\":\"release-notes-tc-eol-notice | Digital Risk Protection Documentation\",\"filePath\":\"src/content/release-notes/threat-command/20250523/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-tc-eol-notice | Digital Risk Protection Documentation\"},{\"name\":\"page\",\"route\":\"/release-notes/threat-command/page\",\"children\":[{\"name\":\"2\",\"route\":\"/release-notes/threat-command/page/2\",\"frontMatter\":{\"title\":\"Digital Risk Protection Release Notes - Page 2\",\"description\":\"Release notes for Digital Risk Protection - Page 2\"},\"title\":\"Digital Risk Protection Release Notes - Page 2\"}],\"title\":\"Page\"}],\"title\":\"Threat Command\"}],\"title\":\"Release Notes\"},{\"name\":\"search\",\"route\":\"/search\",\"frontMatter\":{},\"title\":\"Search\"},{\"name\":\"sensor\",\"route\":\"/sensor\",\"children\":[{\"data\":{\"---\":{\"type\":\"separator\",\"title\":\"Overview\"},\"insight-network-sensor-overview\":{\"title\":\"Network Sensor Overview\"},\"benefits-of-the-insight-network-sensor\":{\"title\":\"- Benefits of the Network Sensor\"},\"data-collected-by-the-insight-network-sensor\":{\"title\":\"- Data Collected by the Network Sensor\"},\"how-insight-products-use-network-sensor-data\":{\"title\":\"- How Insight Products Use Network Sensor Data\"},\"---2\":{\"type\":\"separator\",\"title\":\"Requirements\"},\"insight-network-sensor-requirements\":{\"title\":\"Rapid7 Network Sensor (Insight Network Sensor) Requirements\"},\"network-sensor-host-system-requirements\":{\"t