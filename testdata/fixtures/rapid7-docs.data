":\"20240312\",\"route\":\"/release-notes/insightcloudsec/20240312\",\"frontMatter\":{\"title\":\"24.3.12 Release Notes | Cloud Security Documentation\",\"createdAt\":\"2024-03-12\",\"description\":\"InsightCloudSec is pleased to announce Release 24.3.12\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240312/index.mdx\",\"timestamp\":1783707814950},\"title\":\"24.3.12 Release Notes | Cloud Security Documentation\"},{\"name\":\"20240319\",\"route\":\"/release-notes/insightcloudsec/20240319\",\"frontMatter\":{\"title\":\"24.3.19 Release Notes | Cloud Security Documentation\",\"createdAt\":\"2024-03-19\",\"description\":\"InsightCloudSec is pleased to announce Release 24.3.19\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240319/index.mdx\",\"timestamp\":1783707814950},\"title\":\"24.3.19 Release Notes | Cloud Security Documentation\"},{\"name\":\"20240326\",\"route\":\"/release-notes/insightcloudsec/20240326\",\"frontMatter\":{\"title\":\"24.3.26 Release Notes | Cloud Security Documentation\",\"createdAt\":\"2024-03-26\",\"description\":\"InsightCloudSec is pleased to announce Release 24.3.26\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240326/index.mdx\",\"timestamp\":1783707814950},\"title\":\"24.3.26 Release Notes | Cloud Security Documentation\"},{\"name\":\"20240402\",\"route\":\"/release-notes/insightcloudsec/20240402\",\"frontMatter\":{\"createdAt\":\"2024-04-02\",\"version\":\"24.4.2\",\"description\":\"This release includes enablement of Container Vulnerability Assessment (CVA) for containers running in GCP Kubernetes clusters and container images hosted in GCR repositories.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240402/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240409\",\"route\":\"/release-notes/insightcloudsec/20240409\",\"frontMatter\":{\"createdAt\":\"2024-04-09\",\"version\":\"24.4.9\",\"description\":\"This release includes GCP host vulnerability assessment updates, a new Attack Path Analysis filter, and Kubernetes Cluster scanning changes. \",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240409/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240416\",\"route\":\"/release-notes/insightcloudsec/20240416\",\"frontMatter\":{\"createdAt\":\"2024-04-16\",\"version\":\"4.0.6\",\"description\":\"This release includes new Insights for Kubernetes CVEs and a Kubernetes scan report fix.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240416/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240416-1\",\"route\":\"/release-notes/insightcloudsec/20240416-1\",\"frontMatter\":{\"createdAt\":\"2024-04-16\",\"version\":\"24.4.16\",\"description\":\"This release includes two new Kubernetes Insights and improved Container Vulnerability Assessment error reporting.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240416-1/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240423\",\"route\":\"/release-notes/insightcloudsec/20240423\",\"frontMatter\":{\"createdAt\":\"2024-04-23\",\"version\":\"24.4.23\",\"description\":\"This release includes added support for GCP Organization Policies, an improved Executive Risk View, and several new Query Filters and Insights.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240423/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240430\",\"route\":\"/release-notes/insightcloudsec/20240430\",\"frontMatter\":{\"createdAt\":\"2024-04-30\",\"version\":\"24.4.30\",\"description\":\"This release includes an updated Attack Paths feature for export to PDF, JPG, PNG, and SVG capabilities and an improved multiple attack path user experience.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240430/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240507\",\"route\":\"/release-notes/insightcloudsec/20240507\",\"frontMatter\":{\"createdAt\":\"2024-05-07\",\"version\":\"24.5.7\",\"description\":\"This release includes a new Alibaba Cloud resource, a new AWS Query Filter, and several bug fixes.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240507/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240514\",\"route\":\"/release-notes/insightcloudsec/20240514\",\"frontMatter\":{\"createdAt\":\"2024-05-14\",\"version\":\"24.5.14\",\"description\":\"This release includes the ServiceNow CMDB integration, an improved Bulk Email Bot action, more detailed AWS Instance Interface harvesting, and several bug fixes.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240514/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240521\",\"route\":\"/release-notes/insightcloudsec/20240521\",\"frontMatter\":{\"createdAt\":\"2024-05-21\",\"version\":\"24.5.21\",\"description\":\"This release includes significant updates to Layered Context and public accessibility, several Insights and Query Filters, and a new attribute.\",\"title\":\"24-5-21-release-notes | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240521/index.mdx\",\"timestamp\":1783707814950},\"title\":\"24-5-21-release-notes | Cloud Security Documentation\"},{\"name\":\"20240604\",\"route\":\"/release-notes/insightcloudsec/20240604\",\"frontMatter\":{\"createdAt\":\"2024-06-04\",\"version\":\"24.6.4\",\"description\":\"This release includes two new Azure resources, CIS Kubernetes Compliance Pack updates, and an improved user experience for Badges, Current User Sessions, and Resource Group Details.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240604/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240611\",\"route\":\"/release-notes/insightcloudsec/20240611\",\"frontMatter\":{\"createdAt\":\"2024-06-11\",\"version\":\"24.6.11\",\"description\":\"This release includes 2 new resources, numerous Query Filter and Insight updates and additions, and improved user experience for the Scheduled Events, Cloud Detail Overview, and Basic User Groups pages.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240611/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240618\",\"route\":\"/release-notes/insightcloudsec/20240618\",\"frontMatter\":{\"createdAt\":\"2024-06-18\",\"version\":\"24.6.18\",\"description\":\"This release includes a new AWS Bedrock Agent resource, improvements to the Insights user experience, and several Query Filter and Insight updates.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240618/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240625\",\"route\":\"/release-notes/insightcloudsec/20240625\",\"frontMatter\":{\"createdAt\":\" 2024-06-25\",\"version\":\"24.6.25\",\"description\":\"This release includes several Query Filter and Insight updates, new Kubernetes Insights, and additional Jira Bot Action support.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240625/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240702\",\"route\":\"/release-notes/insightcloudsec/20240702\",\"frontMatter\":{\"createdAt\":\"2024-07-02\",\"version\":\"24.7.2\",\"description\":\"This release includes new Insights for an Azure vulnerability, improved Host Assessment error reporting, and a Vulnerabilities entitlement simplification.\",\"title\":\"24-7-2-release-notes | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240702/index.mdx\",\"timestamp\":1783707814950},\"title\":\"24-7-2-release-notes | Cloud Security Documentation\"},{\"name\":\"20240716\",\"route\":\"/release-notes/insightcloudsec/20240716\",\"frontMatter\":{\"createdAt\":\"2024-07-16\",\"version\":\"24.7.16\",\"description\":\"This release includes a new risk dashboard, several new Insights, a toggle for legacy user interfaces, and support for the AWS CIS 3.0.0 benchmark.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240716/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240723\",\"route\":\"/release-notes/insightcloudsec/20240723\",\"frontMatter\":{\"createdAt\":\"2024-07-23\",\"version\":\"24.7.23\",\"description\":\"This release includes several new Azure and GCP resources, several new Query Filters and Insights, and extended Jinja2 templating support.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240723/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240730\",\"route\":\"/release-notes/insightcloudsec/20240730\",\"frontMatter\":{\"createdAt\":\"2024-07-30\",\"version\":\"24.7.30\",\"description\":\"This release includes several new Query Filters and Insights and improved Azure Autoscaling Groups (Virtual Machine Scale Sets) harvesting.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240730/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240813\",\"route\":\"/release-notes/insightcloudsec/20240813\",\"frontMatter\":{\"createdAt\":\"2024-08-13\",\"version\":\"24.8.13\",\"description\":\"This release includes new AWS resources, many new Query Filters and Insights, and a new compliance pack.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240813/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240820\",\"route\":\"/release-notes/insightcloudsec/20240820\",\"frontMatter\":{\"createdAt\":\"2024-08-20\",\"version\":\"24.8.20\",\"description\":\"This release includes 2 new AWS resources, expanding CIS Azure 2.1 compliance support, and improved AWS Subnet harvesting.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240820/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Release Summary | Cloud Security Documentation\"},{\"name\":\"20240821\",\"route\":\"/release-notes/insightcloudsec/20240821\",\"frontMatter\":{\"createdAt\":\"2024-08-21\",\"version\":\"4.0.7\",\"description\":\"Kubernetes Scanner Release: This release includes includes new Insights and Guardrails checks.\",\"title\":\"Release Summary | Cloud Security Documentation\",\"filePath\":\"src/content/release-notes/insightcloudsec/20240821/index.mdx\",\"timestamp\":178370781