\":1783707814950},\"title\":\"New | Automation Documentation\"},{\"name\":\"20230626\",\"route\":\"/release-notes/insightconnect/20230626\",\"frontMatter\":{\"createdAt\":\"2023-06-26\",\"version\":\"2023-06-26\",\"description\":\"Embedded Quick Actions in InsightVM\",\"title\":\"New | Automation Documentation\",\"filePath\":\"src/content/release-notes/insightconnect/20230626/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Automation Documentation\"},{\"name\":\"20230907\",\"route\":\"/release-notes/insightconnect/20230907\",\"frontMatter\":{\"createdAt\":\"2023-09-07\",\"version\":\"2023-09-07\",\"description\":\"ABA Custom Detection Rule Automation\",\"title\":\"New | Automation Documentation\",\"filePath\":\"src/content/release-notes/insightconnect/20230907/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Automation Documentation\"},{\"name\":\"20231120\",\"route\":\"/release-notes/insightconnect/20231120\",\"frontMatter\":{\"createdAt\":\"2023-11-20\",\"version\":\"2023-11-20\",\"description\":\"Response Actions and Active Response 2.0\",\"title\":\"New | Automation Documentation\",\"filePath\":\"src/content/release-notes/insightconnect/20231120/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Automation Documentation\"},{\"name\":\"20231208\",\"route\":\"/release-notes/insightconnect/20231208\",\"frontMatter\":{\"createdAt\":\"2023-12-08\",\"version\":\"2023-12-08\",\"description\":\"Duplicate a Workflow in InsightConnect\",\"title\":\"New | Automation Documentation\",\"filePath\":\"src/content/release-notes/insightconnect/20231208/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Automation Documentation\"},{\"name\":\"20250523\",\"route\":\"/release-notes/insightconnect/20250523\",\"frontMatter\":{\"createdAt\":\"2025-05-23\",\"description\":\"This document is no longer updated as of May 23, 2025. Read new release notes in the Command Platform Help.\",\"title\":\"release-notes-icon-eol-notice | Automation Documentation\