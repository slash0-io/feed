12\",\"frontMatter\":{\"createdAt\":\"2025-03-12\",\"version\":\"7.10.0\",\"description\":\"This release includes new Microsoft Patch Tuesday content for March, some improvements, and a few bug fixes.\",\"title\":\"New | Nexpose Documentation\",\"filePath\":\"src/content/release-notes/nexpose/20250312/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Nexpose Documentation\"},{\"name\":\"20250324\",\"route\":\"/release-notes/nexpose/20250324\",\"frontMatter\":{\"createdAt\":\"2025-03-24\",\"version\":\"8.0.0\",\"description\":\"This release includes coverage for Aruba AOS-S, Aruba EdgeConnect (ECOS), and Microsoft Visual Studio code, an upgrade to the product and a bug fix.\",\"title\":\"release-notes-8.0.0 | Nexpose Documentation\",\"filePath\":\"src/content/release-notes/nexpose/20250324/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-8.0.0 | Nexpose Documentation\"},{\"name\":\"20250404\",\"route\":\"/release-notes/nexpose/20250404\",\"frontMatter\":{\"createdAt\":\"2025-04-04\",\"version\":\"8.1.0\",\"description\":\"This release addresses issues identified during the roll-out of version 8.0.0.\",\"title\":\"release-notes-8.1.0 | Nexpose Documentation\",\"filePath\":\"src/content/release-notes/nexpose/20250404/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-8.1.0 | Nexpose Documentation\"},{\"name\":\"20250409\",\"route\":\"/release-notes/nexpose/20250409\",\"frontMatter\":{\"createdAt\":\"2025-04-09\",\"version\":\"8.2.0\",\"description\":\"This release includes new Microsoft Patch Tuesday content for April, improvements to the Assets tables and PCI reports, updated vulnerability and policy coverage, and several bug fixes.\",\"title\":\"New | Nexpose Documentation\",\"filePath\":\"src/content/release-notes/nexpose/20250409/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | Nexpose Documentation\"},{\"name\":\"20250416\",\"route\":\"/release-notes/nexpose/20250416\",\"frontMatter\":{\"createdAt\":\"2025-04-16