ocumentation\"},{\"name\":\"20210805\",\"route\":\"/release-notes/appspider/20210805\",\"frontMatter\":{\"createdAt\":\"2021-08-05\",\"version\":\"7.4.027\",\"description\":\"This build has been unstaged from our production environment.\",\"title\":\"Known Issue | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20210805/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Known Issue | AppSpider Pro Documentation\"},{\"name\":\"20210816\",\"route\":\"/release-notes/appspider/20210816\",\"frontMatter\":{\"createdAt\":\"2021-08-16\",\"version\":\"7.4.028\",\"description\":\"This release includes new capabilities such as an Information Leakage attack, some improvements, and several bug fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20210816/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20210827\",\"route\":\"/release-notes/appspider/20210827\",\"frontMatter\":{\"createdAt\":\"2021-08-27\",\"version\":\"7.4.029\",\"description\":\"This release includes an improved XPath Injection module and two fixes.\",\"title\":\"Improved | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20210827/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Pro Documentation\"},{\"name\":\"20210913\",\"route\":\"/release-notes/appspider/20210913\",\"frontMatter\":{\"createdAt\":\"2021-09-13\",\"version\":\"7.4.030\",\"description\":\"This release includes a new flag to disable fallback authentication, improved SQL Injection module logic, and several fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20210913/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20211001\",\"route\":\"/release-notes/appspider/20211001\",\"frontMatter\":{\"createdAt\":\"2021-10-01\",\"version\":\"7.4.031\",\"description\":\"This release includes a new scan configuration field, an improvement to the LinksCrawled counter, and a few fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20211001/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20211021\",\"route\":\"/release-notes/appspider/20211021\",\"frontMatter\":{\"createdAt\":\"2021-10-21\",\"version\":\"7.4.032\",\"description\":\"This release includes a few improvements and several fixes.\",\"title\":\"Improved | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20211021/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Pro Documentation\"},{\"name\":\"20211126\",\"route\":\"/release-notes/appspider/20211126\",\"frontMatter\":{\"createdAt\":\"2021-11-26\",\"version\":\"7.4.033\",\"description\":\"This release includes a few improvements and couple of fixes.\",\"title\":\"Improved | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20211126/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Pro Documentation\"},{\"name\":\"20211222\",\"route\":\"/release-notes/appspider/20211222\",\"frontMatter\":{\"createdAt\":\"2021-12-22\",\"version\":\"7.4.035\",\"description\":\"This release includes a new Out of Band Injection attack module to detect Log4Shell vulnerabilities.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20211222/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20220107\",\"route\":\"/release-notes/appspider/20220107\",\"frontMatter\":{\"createdAt\":\"2022-01-07\",\"version\":\"7.4.036\",\"description\":\"This release includes a new timeout for Bootstrap, a new time-based attack for Postgres, and updated ChromeDriver, and some bug fixes.\",\"title\":\"Improved | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20220107/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Pro Documentation\"},{\"name\":\"20220131\",\"route\":\"/release-notes/appspider/20220131\",\"frontMatter\":{\"createdAt\":\"2022-01-31\",\"version\":\"7.4.037\",\"description\":\"This release includes an updated Log4j recommendation and several fixes.\",\"title\":\"Improved | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20220131/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Pro Documentation\"},{\"name\":\"20220224\",\"route\":\"/release-notes/appspider/20220224\",\"frontMatter\":{\"createdAt\":\"2022-02-24\",\"version\":\"7.4.038\",\"description\":\"This release includes added TLS support, a few improvements, and some fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20220224/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20220331\",\"route\":\"/release-notes/appspider/20220331\",\"frontMatter\":{\"createdAt\":\"2022-03-31\",\"version\":\"7.4.039\",\"description\":\"This release includes the added ability to manage session tokens, a few improvements, and several fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20220331/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20220404\",\"route\":\"/release-notes/appspider/20220404\",\"frontMatter\":{\"createdAt\":\"2022-04-04\",\"version\":\"7.4.040\",\"description\":\"This release includes an updated RCE attack module to detect the Spring4Shell vulnerability.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20220404/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20220512\",\"route\":\"/release-notes/appspider/20220512\",\"frontMatter\":{\"createdAt\":\"2022-05-12\",\"version\":\"7.4.041\",\"description\":\"This release includes a new Out-of-Band SQL Injection module, several improvements, and a few fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20220512/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20220713\",\"route\":\"/release-notes/appspider/20220713\",\"frontMatter\":{\"createdAt\":\"2022-07-13\",\"version\":\"7.4.042\",\"description\":\"This release includes improvements to our attack modules and various fixes. \",\"title\":\"Improved | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20220713/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Pro Documentation\"},{\"name\":\"20220816\",\"route\":\"/release-notes/appspider/20220816\",\"frontMatter\":{\"createdAt\":\"2022-08-16\",\"version\":\"7.4.043\",\"description\":\"This release includes a new check for HTTPS key length, the ability to upload YAML Swagger/OpenAPI files, attack and scan for GraphQL, as well as various improvements and fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20220816/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20220901\",\"route\":\"/release-notes/appspider/20220901\",\"frontMatter\":{\"createdAt\":\"2022-09-01\",\"version\":\"7.4.044\",\"description\":\"This release includes a new attack for NoSQLi, as well as various improvements and fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20220901/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20220914\",\"route\":\"/release-notes/appspider/20220914\",\"frontMatter\":{\"createdAt\":\"2022-09-14\",\"version\":\"7.4.045\",\"description\":\"This release includes various fixes.\",\"title\":\"Fixed | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20220914/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Fixed | AppSpider Pro Documentation\"},{\"name\":\"20220930\",\"route\":\"/release-notes/appspider/20220930\",\"frontMatter\":{\"createdAt\":\"2022-09-30\",\"version\":\"7.4.046\",\"description\":\"This release includes support for GraphQL SDL, as well as various improvements and fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20220930/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20221031\",\"route\":\"/release-notes/appspider/20221031\",\"frontMatter\":{\"createdAt\":\"2022-10-31\",\"version\":\"7.4.047\",\"description\":\"This release includes support for OpenAPI/Swagger multipart/form-data content type, as well as various improvements and fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20221031/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20221128\",\"route\":\"/release-notes/appspider/20221128\",\"frontMatter\":{\"createdAt\":\"2022-11-28\",\"version\":\"7.4.048\",\"description\":\"This release includes improvements to attack modules and various fixes.\",\"title\":\"Improved | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20221128/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Pro Documentation\"},{\"name\":\"20230111\",\"route\":\"/release-notes/appspider/20230111\",\"frontMatter\":{\"createdAt\":\"2023-11-1\",\"version\":\"7.4.056\",\"description\":\"This release includes various improvements and fixes.\",\"title\":\"Improved | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20230111/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Pro Documentation\"},{\"name\":\"20230207\",\"route\":\"/release-notes/appspider/20230207\",\"frontMatter\":{\"createdAt\":\"2023-02-07\",\"version\":\"7.4.049\",\"description\":\"This release includes improvements to attack modules and various fixes.\",\"title\":\"Improved | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20230207/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Pro Documentation\"},{\"name\":\"20230223\",\"route\":\"/release-notes/appspider/20230223\",\"frontMatter\":{\"createdAt\":\"2023-02-23\",\"version\":\"7.4.050\",\"description\":\"This release includes improvements to our attack modules and various fixes.\",\"title\":\"Improved | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20230223/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Pro Documentation\"},{\"name\":\"20230330\",\"route\":\"/release-notes/appspider/20230330\",\"frontMatter\":{\"createdAt\":\"2023-03-30\",\"version\":\"7.4.051\",\"description\":\"This release includes updates to Predictable Resource Location, improvements to attack modules, and various fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20230330/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20230517\",\"route\":\"/release-notes/appspider/20230517\",\"frontMatter\":{\"createdAt\":\"2023-05-17\",\"version\":\"7.4.052\",\"description\":\"This release includes a new attack template, a new attack, as well as various improvements and fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20230517/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20230706\",\"route\":\"/release-notes/appspider/20230706\",\"frontMatter\":{\"createdAt\":\"2023-07-06\",\"version\":\"7.4.053\",\"description\":\"This release includes a new OWASP Top 10 API Security Risks Report, a new attack, as well as various improvements.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20230706/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20230821\",\"route\":\"/release-notes/appspider/20230821\",\"frontMatter\":{\"createdAt\":\"2023-08-21\",\"version\":\"7.4.054\",\"description\":\"This release includes a new attack, a new MSAL authentication option, as well as various fixes.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20230821/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20230915\",\"route\":\"/release-notes/appspider/20230915\",\"frontMatter\":{\"createdAt\":\"2023-09-15\",\"version\":\"7.4.055\",\"description\":\"This release includes a new Selenium ChromeDriver version and an improvement to Swagger UI reports.\",\"title\":\"Improved | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20230915/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Pro Documentation\"},{\"name\":\"20240423\",\"route\":\"/release-notes/appspider/20240423\",\"frontMatter\":{\"createdAt\":\"2024-04-23\",\"version\":\"7.5.009\",\"description\":\"This latest major version release for AppSpider includes new crawler updates, a new REST service, Swagger/OpenAPI upgrade, new attack modules, as well as various improvements.\",\"title\":\"New | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20240423/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Pro Documentation\"},{\"name\":\"20241031\",\"route\":\"/release-notes/appspider/20241031\",\"frontMatter\":{\"createdAt\":\"2024-10-31\",\"version\":\"7.5.013\",\"description\":\"This engine release includes enhancements to the HTTP Headers, the X-Powered-By HTTP Header and Server Configuration modules. It also includes Macro playback improvements as well as various improvements and fixes for Automated Login Finder (ALF).\",\"title\":\"release-notes-7.5.013 | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20241031/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-7.5.013 | AppSpider Pro Documentation\"},{\"name\":\"20241128\",\"route\":\"/release-notes/appspider/20241128\",\"frontMatter\":{\"createdAt\":\"2024-11-28\",\"version\":\"2024.11.28\",\"description\":\"This engine release includes enhancements to the XSS severity when Content-Type is application/json. It also includes R7Crawler improvements, as well as various improvements and fixes for Automated Login Finder (ALF).\",\"title\":\"7.5.014 (released November 28, 2024) | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20241128/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.014 (released November 28, 2024) | AppSpider Pro Documentation\"},{\"name\":\"20250130\",\"route\":\"/release-notes/appspider/20250130\",\"frontMatter\":{\"createdAt\":\"2025-01-30\",\"version\":\"2025.01.30\",\"description\":\"This engine release includes enhancements to the BSQL Injection, File Inclusion and SSL Strength Modules. It also includes various R7Crawler and ChromeHost improvements.\",\"title\":\"7.5.015 (released January 30, 2025) | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20250130/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.015 (released January 30, 2025) | AppSpider Pro Documentation\"},{\"name\":\"20250310\",\"route\":\"/release-notes/appspider/20250310\",\"frontMatter\":{\"createdAt\":\"2025-03-10\",\"version\":\"2025.03.10\",\"description\":\"This engine release includes Macro based HOTP/TOTP Authentication, enhancements to the SSL Strength and Swagger UI DOM Based attack modules. In addition, we have added enhanced Proxy support capabilities. It also includes various R7Crawler and ChromeHost improvements.\",\"title\":\"7.5.016 (released March 10, 2025) | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20250310/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.016 (released March 10, 2025) | AppSpider Pro Documentation\"},{\"name\":\"20250516\",\"route\":\"/release-notes/appspider/20250516\",\"frontMatter\":{\"createdAt\":\"2025-05-16\",\"version\":\"2025.05.16\",\"description\":\"Enhancements to crawling/scanning with R7Crawler improvements including technology analysis, Chromium integration, and macro headers. Scan engine stability and responsiveness improvements. OTP support in ChromeHost macros. Password exposure check enhancements, NodeJS update, report config options, PCI 4.0 mapping, CSP meta tag handling, and ChromeDriver upgrade.\",\"title\":\"7.5.018 (released May 16, 2025) | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20250516/index.mdx\",\"timestamp\":1783707814950},\"title\":\"7.5.018 (released May 16, 2025) | AppSpider Pro Documentation\"},{\"name\":\"20250523\",\"route\":\"/release-notes/appspider/20250523\",\"frontMatter\":{\"createdAt\":\"2025-05-23\",\"description\":\"This document is no longer updated as of May 23, 2025. Read new release notes in the Command Platform Help.\",\"title\":\"release-notes-appspider-eol-notice | AppSpider Pro Documentation\",\"filePath\":\"src/content/release-notes/appspider/20250523/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-appspider-eol-notice | AppSpider Pro Documentation\"},{\"name\":\"page\",\"route\":\"/release-notes/appspider/page\",\"children\":[{\"name\":\"2\",\"route\":\"/release-notes/appspider/page/2\",\"frontMatter\":{\"title\":\"AppSpider Pro Release Notes - Page 2\",\"description\":\"Release notes for AppSpider Pro - Page 2\"},\"title\":\"AppSpider Pro Release Notes - Page 2\"},{\"name\":\"3\",\"route\":\"/release-notes/appspider/page/3\",\"frontMatter\":{\"title\":\"AppSpider Pro Release Notes - Page 3\",\"description\":\"Release notes for AppSpider Pro - Page 3\"},\"title\":\"AppSpider Pro Release Notes - Page 3\"},{\"name\":\"4\",\"route\":\"/release-notes/appspider/page/4\",\"frontMatter\":{\"title\":\"AppSpider Pro Release Notes - Page 4\",\"description\":\"Release notes for AppSpider Pro - Page 4\"},\"title\":\"AppSpider Pro Release Notes - Page 4\"},{\"name\":\"5\",\"route\":\"/release-notes/appspider/page/5\",\"frontMatter\":{\"title\":\"AppSpider Pro Release Notes - Page 5\",\"description\":\"Release notes for AppSpider Pro - Page 5\"},\"title\":\"AppSpider Pro Release Notes - Page 5\"},{\"name\":\"6\",\"route\":\"/release-notes/appspider/page/6\",\"frontMatter\":{\"title\":\"AppSpider Pro Release Notes - Page 6\",\"description\":\"Release notes for AppSpider Pro - Page 6\"},\"title\":\"AppSpider Pro Release Notes - Page 6\"}],\"title\":\"Page\"}],\"title\":\"Appspider\"},{\"name\":\"appspider-enterprise\",\"route\":\"/release-notes/appspider-enterprise\",\"children\":[{\"name\":\"index\",\"route\":\"/release-notes/appspider-enterprise\",\"frontMatter\":{\"title\":\"AppSpider Enterprise Release Notes - Page 1\",\"description\":\"Release notes for AppSpider Enterprise - Page 1\"},\"title\":\"AppSpider Enterprise Release Notes - Page 1\"},{\"name\":\"20201007\",\"route\":\"/release-notes/appspider-enterprise/20201007\",\"frontMatter\":{\"createdAt\":\"2020-10-07\",\"version\":\"3.8.225\",\"description\":\"We added quick access to vulnerability information from the Scans page, plus some general improvements and fixes.\",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20201007/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20201127\",\"route\":\"/release-notes/appspider-enterprise/20201127\",\"frontMatter\":{\"title\":\"Improved | AppSpider Enterprise Documentation\",\"slug\":\"\",\"createdAt\":\"2020-11-27\",\"version\":\"3.8.226\",\"description\":\"We added support for versions 7.4.x of AppSpider Engine, plus some general improvements and fixes.\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20201127/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Enterprise Documentation\"},{\"name\":\"20210218\",\"route\":\"/release-notes/appspider-enterprise/20210218\",\"frontMatter\":{\"createdAt\":\"2021-02-18\",\"version\":\"3.8.227\",\"description\":\"We added support for selenium authentication with .side files, plus some fixes.\",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20210218/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20210416\",\"route\":\"/release-notes/appspider-enterprise/20210416\",\"frontMatter\":{\"createdAt\":\"2021-04-16\",\"version\":\"3.8.228\",\"description\":\"We have added further enhancements to allow AppSpider Enterprise to fully support the 7.4x AppSpider engines, plus some fixes.\",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20210416/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20210520\",\"route\":\"/release-notes/appspider-enterprise/20210520\",\"frontMatter\":{\"createdAt\":\"2021-05-20\",\"version\":\"3.8.229\",\"description\":\"We have added further improvements to allow AppSpider Enterprise to support the 7.4x AppSpider engines, plus some fixes.\",\"title\":\"Improved | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20210520/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Enterprise Documentation\"},{\"name\":\"20210831\",\"route\":\"/release-notes/appspider-enterprise/20210831\",\"frontMatter\":{\"createdAt\":\"2021-08-31\",\"version\":\"3.8.230\",\"description\":\"We have added support to the installer for SQL backup and restore on failure and further config enhancements to match 7.4x AppSpider engines, plus some fixes.\",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20210831/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20220318\",\"route\":\"/release-notes/appspider-enterprise/20220318\",\"frontMatter\":{\"createdAt\":\"2022-03-18\",\"version\":\"3.8.231\",\"description\":\"This release includes a UI update, added Log4Shell support, and several improvements and fixes.\",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20220318/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20220630\",\"route\":\"/release-notes/appspider-enterprise/20220630\",\"frontMatter\":{\"createdAt\":\"2022-06-30\",\"version\":\"3.8.232\",\"description\":\"This release includes the OWASP Top 10 2021 Compliance Report, OWASP 2021 Attack Policy Template, as well as various improvements and fixes.\",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20220630/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20221027\",\"route\":\"/release-notes/appspider-enterprise/20221027\",\"frontMatter\":{\"createdAt\":\"2022-10-27\",\"version\":\"3.8.233\",\"description\":\"This release includes the Out of Band SQL Injection attack module, as well as various improvements and fixes. \",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20221027/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20221213\",\"route\":\"/release-notes/appspider-enterprise/20221213\",\"frontMatter\":{\"createdAt\":\"2022-12-13\",\"version\":\"3.8.234\",\"description\":\"This release includes additional parameters in AuthConfig and various fixes. \",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20221213/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20230126\",\"route\":\"/release-notes/appspider-enterprise/20230126\",\"frontMatter\":{\"createdAt\":\"2023-01-26\",\"version\":\"3.8.235\",\"description\":\"This release includes a new REST endpoint and various fixes. \",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20230126/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20230707\",\"route\":\"/release-notes/appspider-enterprise/20230707\",\"frontMatter\":{\"createdAt\":\"2023-07-07\",\"version\":\"3.8.236\",\"description\":\"This release includes various improvements and fixes. \",\"title\":\"Improved | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20230707/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Improved | AppSpider Enterprise Documentation\"},{\"name\":\"20230920\",\"route\":\"/release-notes/appspider-enterprise/20230920\",\"frontMatter\":{\"createdAt\":\"2023-09-20\",\"version\":\"3.8.237\",\"description\":\"This release includes a new scan config parameter, a new attack, additional MSAL options, as well as various improvements and fixes.\",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20230920/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20240423\",\"route\":\"/release-notes/appspider-enterprise/20240423\",\"frontMatter\":{\"createdAt\":\"2024-04-23\",\"version\":\"3.8.238\",\"description\":\"This release includes a new attack, a new scan config parameter, a new REST endpoint, as well as various improvements and fixes.\",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20240423/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20250506\",\"route\":\"/release-notes/appspider-enterprise/20250506\",\"frontMatter\":{\"createdAt\":\"2025-05-06\",\"version\":\"3.8.239\",\"description\":\"This release includes a API, as well as various improvements.\",\"title\":\"New | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20250506/index.mdx\",\"timestamp\":1783707814950},\"title\":\"New | AppSpider Enterprise Documentation\"},{\"name\":\"20250523\",\"route\":\"/release-notes/appspider-enterprise/20250523\",\"frontMatter\":{\"createdAt\":\"2025-05-23\",\"description\":\"This document is no longer updated as of May 23, 2025. Read new release notes in the Command Platform Help.\",\"title\":\"release-notes-appspiderpro-eol-notice | AppSpider Enterprise Documentation\",\"filePath\":\"src/content/release-notes/appspider-enterprise/20250523/index.mdx\",\"timestamp\":1783707814950},\"title\":\"release-notes-appspiderpro-eol-notice | AppSpider Enterprise Documentation\"},{\"name\":\"page\",\"route\":\"/release-notes/appspider-enterprise/page\",\"children\":[{\"name\":\"2\",\"route\":\"/release-notes/appspider-enterprise/page/2\",\"frontMatter\":{\"title\":\"AppSpider Enterprise Release Notes - Page 2\",\"description\":\"Release notes for AppSpider Enterprise - Page 2\"},\"title\":\"AppSpider Enterprise Release Notes - Page 2\"}],\"title\":\"Page\"}],\"title\":\"Appspider Enterprise\"},{\"name\":\"insight-agent\",\"route\":\"/release-notes/insight-agent\",\"children\":[{\"name\":\"index\",\"route\":\"/relea