":\"release-notes-2025-november\",\"filePath\":\"src/content/insight/release-notes-2025-november/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- November 2025\"},{\"name\":\"release-notes-2025-october\",\"route\":\"/insight/release-notes-2025-october\",\"frontMatter\":{\"title\":\"October 2025 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-2025-october\",\"filePath\":\"src/content/insight/release-notes-2025-october/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- October 2025\"},{\"name\":\"releasenotes-2025sep\",\"route\":\"/insight/releasenotes-2025sep\",\"frontMatter\":{\"title\":\"September 2025 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-2025-september\",\"filePath\":\"src/content/insight/releasenotes-2025sep/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- September 2025\"},{\"name\":\"releasenotes-2025aug\",\"route\":\"/insight/releasenotes-2025aug\",\"frontMatter\":{\"title\":\"August 2025 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-2025aug\",\"filePath\":\"src/content/insight/releasenotes-2025aug/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- August 2025\"},{\"name\":\"releasenotes-2025jul\",\"route\":\"/insight/releasenotes-2025jul\",\"frontMatter\":{\"title\":\"July 2025 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-2025jul\",\"filePath\":\"src/content/insight/releasenotes-2025jul/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- July 2025\"},{\"name\":\"releasenotes-2025june\",\"route\":\"/insight/releasenotes-2025june\",\"frontMatter\":{\"title\":\"June 2025 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"releasenotes-2025jun\",\"filePath\":\"src/content/insight/releasenotes-2025june/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- June 2025\"},{\"name\":\"releasenotes-2025may\",\"route\":\"/insight/releasenotes-2025may\",\"frontMatter\":{\"title\":\"May 2025 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-2025-may\",\"filePath\":\"src/content/insight/releasenotes-2025may/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- May 2025\"},{\"name\":\"release-notes-2025-april\",\"route\":\"/insight/release-notes-2025-april\",\"frontMatter\":{\"title\":\"What's New in April 2025 | Insight Platform Administration Documentation\",\"slug\":\"release-notes-2025-april\",\"filePath\":\"src/content/insight/release-notes-2025-april/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- April 2025\"},{\"name\":\"releasenotes-2025mar\",\"route\":\"/insight/releasenotes-2025mar\",\"frontMatter\":{\"title\":\"What's new in March 2025 | Insight Platform Administration Documentation\",\"slug\":\"release-notes-2025-march\",\"filePath\":\"src/content/insight/releasenotes-2025mar/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- March 2025\"},{\"name\":\"releasenotes-2025feb\",\"route\":\"/insight/releasenotes-2025feb\",\"frontMatter\":{\"title\":\"What's New in February 2025 | Insight Platform Administration Documentation\",\"slug\":\"release-notes-2025-february\",\"filePath\":\"src/content/insight/releasenotes-2025feb/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- February 2025\"},{\"name\":\"releasenotes-2025jan\",\"route\":\"/insight/releasenotes-2025jan\",\"frontMatter\":{\"title\":\"What's New in January 2025 | Insight Platform Administration Documentation\",\"slug\":\"release-notes-2025-january\",\"filePath\":\"src/content/insight/releasenotes-2025jan/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- January 2025\"},{\"name\":\"releasenotes-2024dec\",\"route\":\"/insight/releasenotes-2024dec\",\"frontMatter\":{\"title\":\"What's New in December 2024 | Insight Platform Administration Documentation\",\"slug\":\"release-notes-2024-december\",\"filePath\":\"src/content/insight/releasenotes-2024dec/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- December 2024\"},{\"name\":\"metasploit-pro-release-notes\",\"route\":\"/insight/metasploit-pro-release-notes\",\"frontMatter\":{\"title\":\"Metasploit Pro Release Notes | Insight Platform Administration Documentation\",\"slug\":\"metasploit-pro-release notes\",\"filePath\":\"src/content/insight/metasploit-pro-release-notes/index.mdx\",\"timestamp\":1783707814950},\"title\":\"Metasploit Pro\"},{\"name\":\"release-notes-5.0.0-2026070101\",\"route\":\"/insight/release-notes-5.0.0-2026070101\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 5.0.0-2026070101 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-5.0.0-2026070101\",\"createdAt\":\"2026-07-01\",\"version\":\"5.0.0-2026070101\",\"description\":\"Adds 13 new modules including exploits for Xerte, NTLMRelay2Self, Dalfox, and HP Poly VVX/Trio, along with a new modem session type, 12 enhancements, and 5 bug fixes.\",\"filePath\":\"src/content/insight/release-notes-5.0.0-2026070101/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 5.0.0-2026070101\"},{\"name\":\"release-notes-5.0.0-2026061601\",\"route\":\"/insight/release-notes-5.0.0-2026061601\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 5.0.0-2026061601 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-5.0.0-2026061601\",\"createdAt\":\"2026-06-16\",\"version\":\"5.0.0-2026061601\",\"description\":\"Adds 20 new modules including exploits for Apache ActiveMQ, cPanel/WHM, Gogs, Paperclip AI, and two Linux DirtyFrag LPE vulnerabilities, along with 21 enhancements and 21 bug fixes.\",\"filePath\":\"src/content/insight/release-notes-5.0.0-2026061601/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 5.0.0-2026061601\"},{\"name\":\"release-notes-5.0.0-2026051301\",\"route\":\"/insight/release-notes-5.0.0-2026051301\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 5.0.0-2026051301 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-5.0.0-2026051301\",\"createdAt\":\"2026-05-13\",\"version\":\"5.0.0-2026051301\",\"description\":\"Adds 2 new modules including an NTLM HTTP-to-LDAP relay and a Linux kernel LPE (CVE-2026-31431), along with 15 enhancements covering FTP service improvements and multiple Pro UI updates, plus 10 bug fixes including improved RHEL 9 and RHEL 10 stability.\",\"filePath\":\"src/content/insight/release-notes-5.0.0-2026051301/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 5.0.0-2026051301\"},{\"name\":\"release-notes-5.0.0-2026042601\",\"route\":\"/insight/release-notes-5.0.0-2026042601\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 5.0.0-2026042601 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-5.0.0-2026042601\",\"createdAt\":\"2026-04-26\",\"version\":\"5.0.0-2026042601\",\"description\":\"Adds 13 new modules including exploits for openDCIM, Langflow, Selenium Grid, and Cisco SD-WAN, along with 34 enhancements covering performance improvements, ADCS workflow consolidation, and RISC-V architecture support, plus 10 bug fixes.\",\"filePath\":\"src/content/insight/release-notes-5.0.0-2026042601/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 5.0.0-2026042601\"},{\"name\":\"release-notes-5.0.0-2026040201\",\"route\":\"/insight/release-notes-5.0.0-2026040201\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 5.0.0-2026040201 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-5.0.0-2026040201\",\"createdAt\":\"2026-04-02\",\"version\":\"5.0.0-2026040201\",\"description\":\"Adds 10 new modules including RCE exploits for Eclipse Che, Grav CMS, FreeScout, and FreePBX, along with enhancements and bug fixes improving stability and module functionality.\",\"filePath\":\"src/content/insight/release-notes-5.0.0-2026040201/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 5.0.0-2026040201\"},{\"name\":\"release-notes-5.0.0-2026031101\",\"route\":\"/insight/release-notes-5.0.0-2026031101\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 5.0.0-2026031101 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-5.0.0-2026031101\",\"createdAt\":\"2026-03-11\",\"version\":\"5.0.0-2026031101\",\"description\":\"Metasploit Pro 5.0.0 adds a refreshed User Interface (UI), many quality of life improvements for vulnerability detection and reporting, new attack capabilities, session tagging, and optional Single Sign On (SSO) support via SAML integration with your existing provider\",\"filePath\":\"src/content/insight/release-notes-5.0.0-2026031101/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 5.0.0-2026031101\"},{\"name\":\"release-notes-4.22.9-2026030301\",\"route\":\"/insight/release-notes-4.22.9-2026030301\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 4.22.9-2026030301 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-4.22.9-2026030301\",\"createdAt\":\"2026-03-03\",\"version\":\"4.22.9-2026030301\",\"description\":\"Adds 18 new modules, including multiple unauthenticated RCE exploits, authentication bypasses, and new persistence/evasion techniques across Windows, Linux, web apps, and network devices. It also delivers expanded MITRE ATT\u0026CK metadata, improved service handling, and module refinements—along with several bug fixes to improve stability and accuracy.\",\"filePath\":\"src/content/insight/release-notes-4.22.9-2026030301/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 4.22.9-2026030301\"},{\"name\":\"release-notes-4.22.9-2026020501\",\"route\":\"/insight/release-notes-4.22.9-2026020501\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 4.22.9-2026020501 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-4.22.9-2026020501\",\"createdAt\":\"2026-02-05\",\"version\":\"4.22.9-2026020501\",\"description\":\"This release introduces multiple new exploit modules targeting high-impact RCE vulnerabilities across enterprise software including Oracle EBS, Splunk, FreePBX, Cacti, SmarterMail, and Burp Suite, alongside usability, performance, and stability improvements.\",\"filePath\":\"src/content/insight/release-notes-4.22.9-2026020501/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 4.22.9-2026020501\"},{\"name\":\"release-notes-4.22.9-2026011901\",\"route\":\"/insight/release-notes-4.22.9-2026011901\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 4.22.9-2026011901 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-4.22.9-2026011901\",\"createdAt\":\"2026-01-19\",\"version\":\"4.22.9-2026011901\",\"description\":\"Adds 21 new modules spanning high-impact unauthenticated and authenticated RCEs, persistence techniques (Windows, Linux, Python), and new payload support (RISC-V, ARM), plus expanded scanners and database exploitation via MongoBleed. Metasploit Pro gains improved React2Shell workflows, clearer vulnerability attempt reporting, and more.\",\"filePath\":\"src/content/insight/release-notes-4.22.9-2026011901/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 4.22.9-2026011901\"},{\"name\":\"release-notes-4.22.9-2025121601\",\"route\":\"/insight/release-notes-4.22.9-2025121601\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 4.22.9-2025121601 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-4.22.9-2025121601\",\"createdAt\":\"2025-12-16\",\"version\":\"4.22.9-2025121601\",\"description\":\"Adds support for multiple new modules including persistence modules, modules targeting React Server Components CVE-2025-55182 (React2Shell), FortiWeb, and more. This release adds expanded AD CS MetaModule support (ESC9/10/16), improved session replay and re-run capabilities, improvements for remote service detection, and clearer OS support warnings. It also delivers important stability fixes around Nexpose/InsightVM integrations, the RPC API, and more.\",\"filePath\":\"src/content/insight/release-notes-4.22.9-2025121601/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 4.22.9-2025121601\"},{\"name\":\"release-notes-4.22.9-2025110601\",\"route\":\"/insight/release-notes-4.22.9-2025110601\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 4.22.9-2025110601 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-4.22.9-2025110601\",\"createdAt\":\"2025-11-06\",\"version\":\"4.22.9-2025110601\",\"description\":\"Metasploit Pro adds three modules - a ReDoc API docs detector (read-only HTML marker checks), an unauthenticated RCE against NCR Command Center Agent, and a Windows startup-folder persistence module to drop payloads for specific or all users. It also improves report host/address input validation and reduces memory usage for large exploit batches.\",\"filePath\":\"src/content/insight/release-notes-4.22.9-2025110601/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 4.22.9-2025110601\"},{\"name\":\"release-notes-4.22.8-2025102701\",\"route\":\"/insight/release-notes-4.22.8-2025102701\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 4.22.8-2025102701 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-4.22.8-2025102701\",\"createdAt\":\"2025-10-27\",\"version\":\"4.22.8-2025102701\",\"description\":\"This update adds new modules for vulnerabilities in Listmonk, MotionEye (CVE-2025-60787), and Vvveb (CVE-2025-8518), plus a Windows Script Host file generator. This update also includes fixes for database startup issues during installation/updates and fixes missing replay functionality in the Single Credentials Testing MetaModule.\",\"filePath\":\"src/content/insight/release-notes-4.22.8-2025102701/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 4.22.8-2025102701\"},{\"name\":\"release-notes-4.22.8-2025101401\",\"route\":\"/insight/release-notes-4.22.8-2025101401\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 4.22.8-2025101401 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-4.22.8-2025101401\",\"createdAt\":\"2025-10-14\",\"version\":\"4.22.8-2025101401\",\"description\":\"This release delivers several enhancements and bug fixes for Metasploit Pro, including improved page loading performance, fixes for social engineering campaign issues, and fixing backup and restore issues. Users are also notified when root access is required for certain tools.\",\"filePath\":\"src/content/insight/release-notes-4.22.8-2025101401/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 4.22.8-2025101401\"},{\"name\":\"release-notes-4.22.8-2025091701\",\"route\":\"/insight/release-notes-4.22.8-2025091701\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 4.22.8-2025091701 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-4.22.8-2025091701\",\"createdAt\":\"2025-09-17\",\"version\":\"4.22.8-2025091701\",\"description\":\"Adds multiple improvements, exploit modules, increased support for scanning capabilities and re-installation process, a new enhanced bash profile exploit persistence functionality, and more.\",\"filePath\":\"src/content/insight/release-notes-4.22.8-2025091701/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 4.22.8-2025091701\"},{\"name\":\"release-notes-4.22.8-2025082101\",\"route\":\"/insight/release-notes-4.22.8-2025082101\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 4.22.8-2025082101 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-4.22.8-2025082101\",\"createdAt\":\"2025-08-22\",\"version\":\"4.22.8-2025082101\",\"description\":\"Adds multiple improvements, exploit modules, support for single module run replay capabilities, a new enhanced user interface for specifying PKCS#12 certificates or Kerberos credential cache files, and more.\",\"filePath\":\"src/content/insight/release-notes-4.22.8-2025082101/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 4.22.8-2025082101\"},{\"name\":\"release-notes-4.22.8-2025080401\",\"route\":\"/insight/release-notes-4.22.8-2025080401\",\"frontMatter\":{\"title\":\"Metasploit Pro Version 4.22.8-2025080401 Release Notes | Insight Platform Administration Documentation\",\"slug\":\"release-notes-4.22.8-2025080401\",\"createdAt\":\"2025-08-04\",\"version\":\"4.22.8-2025080401\",\"description\":\"Adds multiple improvements and support for Active Directory Certificate Services (AD CS) workflows and exploitation.\",\"filePath\":\"src/content/insight/release-notes-4.22.8-2025080401/index.mdx\",\"timestamp\":1783707814950},\"title\":\"- 4.22.8-2025080401\"},{\"name\":\"external_link_releasenotesarchive\",\"route\":\"/insight/external_link_releasenotesarchive\",\"frontMatter\":{\"title\":\"Index\",\"filePath\":\"src/content/insight/external_link_releasenotesarchive/index.mdx\",\"timestamp\":1783707814950},\"title\":\"EXTERNAL_LINK.https://docs.rapid7.com/release-notes/insightvm/.TITLE.Release Notes Archive\"}],\"title\":\"Insight\"},{\"name\":\"insight-agent\",\"route\":\"/insight-agent\",\"children\":[{\"data\":{\"---\":{\"type\":\"separator\",\"title\":\"Overview\"},\"overview\":{\"title\":\"Overview\"},\"benefits\":{\"title\":\"Benefits\"},\"data-collected\":{\"title\":\"How the Rapid7 Agent (Insight Agent) Works\"},\"sysmon-installer-events-monitor-overview\":{\"title\":\"- Sysmon Installer and Events Monitor overview\"},\"how-the-insight-agent-software-updates\":{\"title\":\"- Software Updates\"},\"endpoint-prevention-overview\":{\"title\":\"- Endpoint Prevention\"},\"insight-agent-version-3-faqs\":{\"title\":\"Frequently Asked Questions\"},\"---2\":{\"type\":\"separator\",\"title\":\"Requirements\"},\"requirements\":{\"title\":\"Rapid7 Agent (Insight Agent) requirements\"},\"operating-system\":{\"title\":\"- Operating system support\"},\"network-traffic-and-connectivity-requirements\":{\"title\":\"- Network traffic and connectivity\"},\"epp-software-requirements\":{\"title\":\"- Endpoi