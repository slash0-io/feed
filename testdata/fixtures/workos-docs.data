79 9.62041C5.89053 9.81567 5.57402 9.81567 5.37876 9.62041C5.18404 9.4251 5.18368 9.10846 5.37876 8.91338L8.91391 5.37822ZM8.1395 2.05889C9.1042 1.50111 10.2992 1.50903 11.2274 2.11846L11.4168 2.25811C11.6081 2.41402 11.8142 2.62226 12.0965 2.90459C12.4729 3.28097 12.7166 3.52133 12.8817 3.77275L12.9959 3.96123C13.4902 4.85869 13.4619 5.96014 12.9413 6.86064L12.8221 7.0501C12.7365 7.17616 12.6315 7.3007 12.4989 7.44268L12.0077 7.94268L11.3885 8.56084C11.1932 8.75595 10.8767 8.75605 10.6815 8.56084C10.4866 8.3656 10.4865 8.04899 10.6815 7.85381L11.3006 7.23564L11.7684 6.75908C11.8753 6.64519 11.9426 6.56569 11.995 6.48857L12.076 6.35967C12.4289 5.74954 12.4376 5.02132 12.119 4.44268L12.0457 4.32158C11.951 4.17733 11.8004 4.02345 11.3885 3.61162C11.0799 3.30299 10.9163 3.14093 10.7928 3.03936L10.6786 2.95439C10.083 2.56329 9.29401 2.54612 8.64048 2.92412L8.51157 3.00518C8.43446 3.05757 8.35494 3.12484 8.24106 3.23174L7.76548 3.69951L7.14633 4.31865C6.95112 4.5137 6.63453 4.51368 6.4393 4.31865C6.24411 4.12344 6.2442 3.80689 6.4393 3.61162L7.05747 2.99248L7.55747 2.50225C7.69965 2.36939 7.82384 2.26376 7.95005 2.17803L8.1395 2.05889Z" fill="currentColor"></path></svg></a></div></div><script data-permanent-link-props="" type="application/json">{"href":"#what-you-will-build","label":"Section titled What you’ll build","childrenHtml":"\u003Ch2 id=\"what-you-will-build\" class=\"rt-Heading rt-r-size-5 rt-r-mt-7 rt-r-mb-3\">What you’ll build\u003C/h2>"}</script>
<p class="rt-Text rt-r-size-3 rt-r-mb-4">In this guide, we will walk you through what you will need to set up webhooks:</p>
<ul class="rt-Box rt-r-pl-5 rt-r-mb-5">
<li class="rt-Text rt-r-size-3 rt-r-mb-2">Create your endpoint to receive webhook events</li>
<li class="rt-Text rt-r-size-3 rt-r-mb-2">Register your endpoint with WorkOS</li>
<li class="rt-Text rt-r-size-3 rt-r-mb-2">Process the events received from WorkOS</li>
<li class="rt-Text rt-r-size-3 rt-r-mb-2">Test your endpoint</li>
</ul>
<span data-accent-color="gray" class="rt-Separator rt-r-orientation-horizontal rt-r-size-4 rt-r-my-7"></span>
</div><div tabindex="-1" data-section-slug="1-set-up-your-webhook-endpoint"><div data-permanent-link-root="" style="display:contents"><div class="PermanentLink"><div class="PermanentLinkInner"><h2 id="1-set-up-your-webhook-endpoint" class="rt-Heading rt-r-size-5 rt-r-mt-7 rt-r-mb-3"><span style="margin-right:0.5em" data-algolia-exclude="true" class="rt-Text Marker"><span class="MarkerCircle"><span class="MarkerContent">1</span></span></span>Set up your webhook endpoint</h2></div><a aria-label="Section titled (1) Set up your webhook endpoint" class="PermanentLinkIcon" href="#1-set-up-your-webhook-endpoint" data-state="closed"><svg width="16" height="16" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3.6893 6.37529C3.88335 6.24731 4.14742 6.26897 4.31821 6.43975C4.51323 6.63496 4.51323 6.95156 4.31821 7.14678L3.69907 7.76592C3.37878 8.08621 3.20737 8.25925 3.09751 8.39092L3.00473 8.51201C2.54529 9.18833 2.53677 10.0437 2.95395 10.679L3.03891 10.7933C3.14049 10.9167 3.30254 11.0803 3.61118 11.389C4.02302 11.8008 4.17689 11.9514 4.32114 12.0462L4.44223 12.1194C5.06223 12.4608 5.85391 12.4263 6.48813 11.9954L6.60923 11.9026C6.74094 11.7927 6.91473 11.6216 7.2352 11.3011L7.85337 10.6819C8.04855 10.4869 8.36517 10.487 8.5604 10.6819C8.7556 10.8771 8.75548 11.1937 8.5604 11.389L7.94223 12.0081C7.64648 12.3039 7.43399 12.5174 7.24008 12.678L7.04965 12.8226C6.11777 13.4555 4.9223 13.5259 3.96079 12.9964L3.77231 12.8821C3.52088 12.717 3.28054 12.4734 2.90415 12.097C2.62181 11.8146 2.41357 11.6085 2.25766 11.4173L2.11801 11.2278C1.468 10.2379 1.50252 8.94437 2.17758 7.95049L2.32212 7.76006C2.48279 7.56615 2.69629 7.35366 2.99204 7.05791L3.61118 6.43975L3.6893 6.37529ZM8.91391 5.37822C9.109 5.18318 9.42565 5.18352 9.62094 5.37822C9.81619 5.57347 9.81616 5.88999 9.62094 6.08525L6.08579 9.62041C5.89053 9.81567 5.57402 9.81567 5.37876 9.62041C5.18404 9.4251 5.18368 9.10846 5.37876 8.91338L8.91391 5.37822ZM8.1395 2.05889C9.1042 1.50111 10.2992 1.50903 11.2274 2.11846L11.4168 2.25811C11.6081 2.41402 11.8142 2.62226 12.0965 2.90459C12.4729 3.28097 12.7166 3.52133 12.8817 3.77275L12.9959 3.96123C13.4902 4.85869 13.4619 5.96014 12.9413 6.86064L12.8221 7.0501C12.7365 7.17616 12.6315 7.3007 12.4989 7.44268L12.0077 7.94268L11.3885 8.56084C11.1932 8.75595 10.8767 8.75605 10.6815 8.56084C10.4866 8.3656 10.4865 8.04899 10.6815 7.85381L11.3006 7.23564L11.7684 6.75908C11.8753 6.64519 11.9426 6.56569 11.995 6.48857L12.076 6.35967C12.4289 5.74954 12.4376 5.02132 12.119 4.44268L12.0457 4.32158C11.951 4.17733 11.8004 4.02345 11.3885 3.61162C11.0799 3.30299 10.9163 3.14093 10.7928 3.03936L10.6786 2.95439C10.083 2.56329 9.29401 2.54612 8.64048 2.92412L8.51157 3.00518C8.43446 3.05757 8.35494 3.12484 8.24106 3.23174L7.76548 3.69951L7.14633 4.31865C6.95112 4.5137 6.63453 4.51368 6.4393 4.31865C6.24411 4.12344 6.2442 3.80689 6.4393 3.61162L7.05747 2.99248L7.55747 2.50225C7.69965 2.36939 7.82384 2.26376 7.95005 2.17803L8.1395 2.05889Z" fill="currentColor"></path></svg></a></div></div><script data-permanent-link-props="" type="application/json">{"href":"#1-set-up-your-webhook-endpoint","label":"Section titled (1) Set up your webhook endpoint","childrenHtml":"\u003Ch2 id=\"1-set-up-your-webhook-endpoint\" class=\"rt-Heading rt-r-size-5 rt-r-mt-7 rt-r-mb-3\">\u003Cspan style=\"margin-right:0.5em\" data-algolia-exclude=\"true\" class=\"rt-Text Marker\">\u003Cspan class=\"MarkerCircle\">\u003Cspan class=\"MarkerContent\">1\u003C/span>\u003C/span>\u003C/span>Set up your webhook endpoint\u003C/h2>"}</script>
<p class="rt-Text rt-r-size-3 rt-r-mb-4">Create a public endpoint that WorkOS can send events to. This endpoint should use HTTPS and should accept POST requests with the <code data-accent-color="gray" class="rt-reset rt-Code rt-variant-soft rt-high-contrast">workos-signature</code> header.</p>
<div class="rt-Box rt-r-mt-5 rt-r-mb-6"><div style="display:contents" data-is-root-theme="true" data-accent-color="purple" data-gray-color="slate" data-has-background="true" data-panel-background="translucent" data-radius="medium" data-scaling="100%" class="radix-themes"><div dir="ltr" data-orientation="horizontal" class="rt-TabsRoot"><div class="CodeBlockRoot" data-algolia-exclude="true"><div class="CodeBlockHeader"><div class="rt-Box rt-r-mr-4"><div role="tablist" aria-orientation="horizontal" style="outline:none" class="rt-BaseTabList rt-TabsList rt-r-size-2" tabindex="-1" data-orientation="horizontal"><button type="button" role="tab" aria-selected="true" aria-controls="radix-_r756R_0_-content-js-1" data-state="active" id="radix-_r756R_0_-trigger-js-1" class="rt-reset rt-BaseTabListTrigger rt-TabsTrigger" tabindex="-1" data-orientation="horizontal" data-radix-collection-item=""><span class="rt-BaseTabListTriggerInner rt-TabsTriggerInner">Next.js</span><span class="rt-BaseTabListTriggerInnerHidden rt-TabsTriggerInnerHidden">Next.js</span></button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_r756R_0_-content-js-2" data-state="inactive" id="radix-_r756R_0_-trigger-js-2" class="rt-reset rt-BaseTabListTrigger rt-TabsTrigger" tabindex="-1" data-orientation="horizontal" data-radix-collection-item=""><span class="rt-BaseTabListTriggerInner rt-TabsTriggerInner">Express</span><span class="rt-BaseTabListTriggerInnerHidden rt-TabsTriggerInnerHidden">Express</span></button></div></div><div class="rt-Flex rt-r-ai-center rt-r-gap-2"><div style="position:relative" class="rt-Flex rt-r-ai-center rt-r-gap-1"><span data-accent-color="gray" data-code-language-text="" class="rt-Text rt-r-size-1">JavaScript</span><button data-accent-color="gray" style="color:var(--gray-a11)" class="rt-reset rt-SelectTrigger rt-r-size-1 rt-variant-ghost rt-r-mr-1" type="button" role="combobox" aria-controls="radix-_r756R_aj_" aria-expanded="false" aria-autocomplete="none" dir="ltr" data-state="closed"><span class="rt-SelectTriggerInner"><span style="pointer-events:none"></span></span><svg width="9" height="9" viewBox="0 0 9 9" fill="currentcolor" xmlns="http://www.w3.org/2000/svg" class="rt-SelectIcon" aria-hidden="true"><path d="M0.135232 3.15803C0.324102 2.95657 0.640521 2.94637 0.841971 3.13523L4.5 6.56464L8.158 3.13523C8.3595 2.94637 8.6759 2.95657 8.8648 3.15803C9.0536 3.35949 9.0434 3.67591 8.842 3.86477L4.84197 7.6148C4.64964 7.7951 4.35036 7.7951 4.15803 7.6148L0.158031 3.86477C-0.0434285 3.67591 -0.0536285 3.35949 0.135232 3.15803Z"></path></svg></button><select aria-hidden="true" tabindex="-1" style="position:absolute;border:0;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;word-wrap:normal"></select><select data-code-language-select="" aria-label="Select language" style="position:absolute;inset:0;opacity:0;cursor:pointer"><option value="dotnet">.NET</option><option value="go">Go</option><option value="java">Java</option><option value="js" selected="">JavaScript</option><option value="laravel">Laravel</option><option value="php">PHP</option><option value="python">Python</option><option value="ruby">Ruby</option></select></div><div data-code-block-copy-button-root="" style="display:contents"><button tabindex="0" type="button" class="reset-button IconButton state-normal rt-r-size-2 gray" aria-label="Copy" data-state="closed"><svg width="16" height="16" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 4.00003V2.50003C10 2.22389 9.77614 2.00003 9.5 2.00003H2.5C2.22386 2.00003 2 2.22389 2 2.50003V9.50003C2 9.77617 2.22386 10 2.5 10H4V5.50003C4 4.6716 4.67157 4.00003 5.5 4.00003H10ZM5.5 5.00003C5.22386 5.00003 5 5.22389 5 5.50003V12.5C5.00002 12.7762 5.22387 13 5.5 13H12.5C12.7761 13 13 12.7762 13 12.5V5.50003C13 5.22389 12.7761 5.00003 12.5 5.00003H5.5ZM12.5 4.00003C13.3284 4.00003 14 4.6716 14 5.50003V12.5C14 13.3284 13.3284 14 12.5 14H5.5C4.67159 14 4.00002 13.3284 4 12.5V11H2.5C1.67157 11 1 10.3285 1 9.50003V2.50003C1 1.6716 1.67157 1.00003 2.5 1.00003H9.5C10.3284 1.00003 11 1.6716 11 2.50003V4.00003H12.5Z" fill="currentColor"></path></svg></button></div><script data-code-block-copy-button-props="" type="application/json">{"copyLabel":"Copy"}</script></div></div><div data-state="active" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_r756R_0_-trigger-js-1" id="radix-_r756R_0_-content-js-1" tabindex="0" style="animation-duration:0s" class="rt-TabsContent"><pre class="CodeBlockContent ws-pre" data-language="ts"><div dir="ltr" class="ScrollAreaRoot" style="position:relative;--radix-scroll-area-corner-width:0px;--radix-scroll-area-corner-height:0px"><style>[data-radix-scroll-area-viewport]{scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;}[data-radix-scroll-area-viewport]::-webkit-scrollbar{display:none}</style><div data-radix-scroll-area-viewport="" class="ScrollAreaViewport" style="overflow-x:hidden;overflow-y:hidden"><div style="min-width:100%;display:table"><code class="CodeBlockCode"><div class="CodeBlockContentInner"><table role="presentation" class="CodeBlockLineGroup gutter-numbers"><tbody><tr class="CodeBlockLine"><td class="CodeBlockLineGutter"></td><td class="CodeBlockLineContent"><span class="token keyword">import</span> <span class="token keyword">type</span> <span class="token punctuation">{</span> <span class="token">NextApiRequest</span><span class="token punctuation">,</span> <span class="token">NextApiResponse</span> <span class="token punctuation">}</span> <span class="token keyword">from</span> <span class="token string">&#39;next&#39;</span><span class="token punctuation">;</span>
</td></tr><tr class="CodeBlockLine"><td class="CodeBlockLineGutter"></td><td class="CodeBlockLineContent">
</td></tr><tr class="CodeBlockLine"><td class="CodeBlockLineGutter"></td><td class="CodeBlockLineContent"><span class="token keyword">export</span> <span class="token keyword">default</span> <span class="token punctuation">(</span><span class="token">req</span><span class="token operator">:</span> <span class="token">NextApiRequest</span><span class="token punctuation">,</span> <span class="token">res</span><span class="token operator">:</span> <span class="token">NextApiResponse</span><span class="token punctuation">)</span> <span class="token operator">=&gt;</span> <span class="token punctuation">{</span>
</td></tr><tr class="CodeBlockLine"><td class="CodeBlockLineGutter"></td><td class="CodeBlockLineContent">  <span class="token keyword">if</span> <span class="token punctuation">(</span><span class="token">req</span><span class="token punctuation">.</span><span class="token">method</span> <span class="token operator">===</span> <span class="token string">&#39;POST&#39;</span><span class="token punctuation">)</span> <span class="token punctuation">{</span>
</td></tr><tr class="CodeBlockLine"><td class="CodeBlockLineGutter"></td><td class="CodeBlockLineContent">    <span class="token keyword">const</span> <span class="token">payload</span> <span class="token operator">=</span> <span class="token">req</span><span class="token punctuation">.</span><span class="token">body</span><span class="token punctuation">;</span>
</td></tr><tr class="CodeBlockLine yellow"><td class="CodeBlockLineGutter"></td><td class="CodeBlockLineContent">    <span class="token keyword">const</span> <span class="token">sigHeader</span> <span class="token operator">=</span> <span class="token">req</span><span class="token punctuation">.</span><span class="token">headers</span><span class="token punctuation">[</span><span class="token string">&#39;workos-signature&#39;</span><span class="token punctuation">]</span><span class="token punctuation">;</span>
</td></tr><tr class="CodeBlockLine"><td class="CodeBlockLineGutter"></td><td class="CodeBlockLineContent">
</td></tr><tr class="CodeBlockLine"><td class="CodeBlockLineGutter"></td><td class="CodeBlockLineContent">    <span class="token comment">// Verify the signature and process the event</span>
