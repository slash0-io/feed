pe%22%3A%22Published%22%7D">
<link rel="stylesheet" id="siteforce_fontStyleSheet" href="/s/sfsites/runtimedownload/fonts.css?lastMod=1689189241000&amp;brandSet=8e599f81-9c89-42b0-82f3-cb2d93349b82" type="text/css">
<style id="themeCSS"></style><style id="customCSS">/* Increase font size on article pages  */
body {font-size: 1.125rem !important;}

.headlineTitle .uiOutputText {
    font-size: 32px !important;
    line-height: 44.8px !important; 
}

/*Trending Articles Widget*/
.comm-topic-trending-articles h2 {
    font-size: 20px;
}

.slds-text-body_small, .slds-text-body--small{
	font-size: 16px;
}


/*menuitem style*/
.menuItemLink{
    padding: 6px;
    position: absolute;
    right: 22.5%;
    display: inline-block;
    max-width: 100%;
    width:198.672px;
    height: 36px;
    font-size: 14px;
    overflow: hidden;
    white-space: nowrap;
    font-weight: 300;
    font-family: "Open Sans";
    line-height: 21px;
}

/* DKB 2/3/21 NavBar List Item*/
.slds-list__item li{
    background: #ffffff; 
    color: #000000;
}

.slds-button--neutral.newsbutton
{
    background-color: #63b246;
    color:#fff;
} 
.uiInputSelect>.uiMenu{
   display: none;
    
}

.uiPicklistLabel.uiPicklistLabel-left {
       display: none;

}

.siteforcePanelsContainer .required{
     display: none;  
}
/* Wraps email text on Case Feed */

.forceChatterFeedAuxBodyEmailMessage .inFeed .emailMessageBody { 
word-wrap: break-word; 
}
/* remove the last item in list views */
.slds-dropdown__list li:last-child {
    display: none !important;
}

.li:last-child  {
   float: right;
}

/*Styling the new button*/
.oneActionsRibbon li.slds-button--neutral a, .slds-button--neutral a{
    background-color: #63b246;
    color:#fff !important;
}


/* ???? - don't know why but its here ???? */
div.slds-rich-text-editor__output ul li {
     margin-left: 60px;
 }
 div.slds-rich-text-editor__output ol li {
    margin-left: 40px;
 }
 .slds-pill_container--bare.selfServiceArticleTopicList.selfServiceArticleLayout {
   display: none;
 }
.slds-rich-text-editor__textarea a, .slds-rich-text-editor__output a {
    word-break: normal;
}

/* Search Adjustments */

.forceCommunityOmniBox a.switcher-option.selected {
    color: #63b246;
}

/*.slds-large-size--4-of-12 {
    width: 100px;
}*/

.slds-rich-text-editor__textarea a, .slds-rich-text-editor__output a {
    word-break: normal;
}

.headerText{background-color: #509439; 
}
 
.minimizeButton {background-color: #509439; 
} 

.closeButton {background-color: #509439; 
}

.sidebarHeader.embeddedServiceSidebarExtendedHeader.embeddedServiceSidebarExtendedHeader{background-color: #509439;
}

/*Show links as underlined in the chat window*/		
.chatContent a{text-decoration:underline;}		
.chatContent a:hover{text-decoration:underline;}		
.chatContent a:focus{text-decoration:underline;}		
/*Fix disappearing label for active chat buttons*/		
a.chatOption:hover{color:#fff;}

/*Update the corner buttons of the chat modal window*/
/*.modalContainer .sidebarHeader .dockableContainer .sidebarHeader .shortHeader .shortHeaderContent .minimizeButton { background-color: purple;}
.modalContainer .sidebarHeader .dockableContainer .sidebarHeader .shortHeader .shortHeaderContent .closeButton { background-color: orange;}*/
.minimizeButton { background-color: #509439 !important;}
.closeButton { background-color: #509439 !important;}
.headerText{background-color: #509439 !important;}
/*change the black background displayed after entering data but before getting agent in chat window*/
.dockableContainer .embeddedServiceSidebarExtendedHeader {background-color:#509439 !important;}


/* Duo-specific codeblocks */
/*SFDC-3971, Commented out for code wrap for commands*/
/*.ckeditor_codeblock {
	background-color:#444 !important;
    overflow : hidden ;
    white-space : pre-wrap;
 }*/
.ckeditor_codeblock::selection, .ckeditor_codeblock a::selection {
	color:#ffffff !important;
	background-color: #6bbf4e;
 }

/* Duo-specific codeblocks - don't show hyperlinks, its a codeblock */
.ckeditor_codeblock a {
    color: #ffffff;
    cursor: text;
    pointer-events: none;
}
.ckeditor_codeblock a:link:hover {
    color: #ffffff;
    cursor: text;
}
.ckeditor_codeblock a:visited:hover {
    color: #ffffff;
    cursor: text;
}

/*Article headline fixes for tablet and desktop sizes*/
@media screen and (min-width: 481px){
    /*.comm-page-article .cCenterPanel .forcePageBlockItemView .itemBody .uiOutputText:nth-child(1){display:none;}*/
    /*.slds-form-element .test-id__field-label-container {display:none;}*/
    /*SFDC-3223*/
    article.content .forcePageBlockSectionRow:nth-child(1){display:none;}
    .selfServiceArticleLayout .slds-form-element .test-id__field-label{font-size: 1.1875rem !important; font-family: "Open Sans"!important;}
    .selfServiceArticleLayout .slds-form-element .test-id__field-value{font-size: 1.13203125rem !important; font-family: "Open Sans"!important;}
    /*.slds-form > div:first-child {display:none;}*/
    .slds-col--padded .ui-widget {margin: 15px;}
}

/*Article headline and logo fixes for phone sizes*/
@media screen and (max-width: 480px) {
    .comm-page-article .cCenterPanel .forcePageBlockItemView .itemBody .uiOutputText:nth-child(1){font-size: 1.31em;}
    /*SFDC-3223*/
    .selfServiceArticleLayout .slds-form-element__label{font-size: 1.055553rem !important; font-weight: bold !important; font-family: "Open Sans"!important;}
    .summary p, .summary div{display:none;}
    .slds-medium-size--4-of-12{display:none;}
    .article-column{width:100%;}
    .headlineTitleText{display:block;}
    
}

/*Hide urlName which is now mandatory and can't be hidden by permission set*/
article.content .forcePageBlockSectionRow:nth-child(2){display:none;}

/* Logo fixes for phone sizes*/
@media screen and (max-width: 480px) {
	.logo-wrap{width:30%;} 
    .utility-nav{float:right;width:55%}
    .site-header-inner-wrap{display:block;}
    .inner{margin: 0 10px 0 15px;}
    .main-nav-lg-list {display:none;}
    /*SFDC-3971, Remove Profile Con for mobile*/
    .cHeaderLine .cProfileCon{display:none;}
}
/* Logo fixes for tablet sizes*/
@media screen and (min-width: 480px) and (max-width: 1150px){ 
	.logo-wrap{width:30%;} 
    .utility-nav{float:right;width:55%}
    .site-header-inner-wrap{display:block;}
    .inner{margin: 0 10px 0 15px;}
    .main-nav-lg-list {display:none;}
}
/*** Search Bar Tweaks ***, SFDC-3971, Made available for mobile*/
@media screen and (min-width: 481px) {
.cHeaderLine .cTopLeftCon{display:none;}
.cHeaderLine .slds-col_bump-left{display:none;}
}

.cHeaderLine .cBrandingProfile{display:none;}
/*.cHeaderLine .cProfileCon{display:none;}*/

/*Remove Duplicate article headlines and underline*/
/*.comm-page-article .cCenterPanel .forcePageBlockItemView .itemBody .uiOutputText{display:none;}*/
.forceCommunityRecordDetail .cCenterPanel .forcePageBlockItemView .itemBody .uiOutputText{display:block;}
.forcePageBlockItemView .slds-form-element_separator{border-bottom:0px !important;}

/*paragraph tags are being inserted into list items - force these to not display as a block element*/
li p {display:inline;}


/* fix solid button */
.btn-signup {background-color: transparent;}

/*Hiding Merge Button*/
li.slds-truncate:nth-child(2){
   display:none;
}

/* Prevent auto links from displaying by wrapping content with a span, classed as .preventAutoLink */
.preventAutoLink a { color: #444444; cursor: text; pointer-events: none;}
.preventAutoLink a:link:hover {color: #444444; cursor: text;}
.preventAutoLink a:visited:hover {color: #444444; cursor: text;}

/*make tables more pronounced*/
.uiOutputRichText td {border: 1px solid #888;}
/*SFDC-3971, Take out wierd table font*/
/*.uiOutputRichText tr:first-child td {background-color:#000;color:#fff;border: 1px solid #888;}*/

/*remove the select box from the logged in community view*/
.inlineEditGrid .forceRecordLayout .cellContainer .slds-button {display:none;}

/* Ensure that table content doesn't break mid-word */
td {word-break:normal;}
.selfServiceArticleLayout.zoom.article-column{padding:0px !important;}

/*Remove Title, Article Template headings from Article Detail*/
/*.selfServiceArticleLayout .test-id__field-label{display:none;}*/

/*Hide All buttons except for 'New' in Support Cases List View, SFDC-3971, removed Standard Case Button*/
li.slds-button:nth-child(1),li.slds-button:nth-child(2),
li.slds-button:nth-child(3),li.slds-button:nth-child(4),
li.slds-button:nth-child(5),li.slds-button:nth-child(6){
   display:none;
}
/*SFDC-3971, New Changes*/
/*Home Heading*/
.forceCommunityHeadline .headlineTitleText {
    font-size: 1.75rem; 
}

/*Home trnasparency in Nav Bar*/
.cNavBarCon {
	background-color: rgba(0, 0, 0, 0.2) !important;
}

/*Width in Navigation*/
.siteforceServiceBody .cHeaderPanel{
    height: 11rem;
}

/*Home search font*/
.siteforceServiceBody .cHeaderPanel .cSearchPublisher .search-field-wrapper .search-field {
    font-size: 1.25rem;
}

/*Home profile name width*/
.siteforceServiceBody .cProfileCon {
  width: 30% !important;
}

/*Nav Bar Padding*/
.siteforceServiceBody .comm-navigation{
  border-top: 0.5px solid rgba(255,255,255, 0.35);
  border-bottom: 0.5px solid rgba(255,255,255, 0.35);  
  padding: 5px;

}

/*Article Headline font size*/
.cCenterPanel .headlineTitleText {
    font-size: 1.75rem !important; font-family: "Open Sans"!important;
}

/*Hide New case create button for Mobile*/
.forceCommunityRecordListMobile .slds-button:nth-child(3){
   display:none;
}

/*Multi-select in Case creation*/
.select2-container .select2-results{
  font-size: 16px;
  color: #888888;
}
.select2-container .select2-selection--multiple {
    border-color: rgba(0, 0, 0, 0.05) !important;   
}
.select2-container .select2-selection--multiple:focus {/*, .select2-container .select2-selection--multiple:active  {*/
    border-color: rgb(21, 137, 238); /* This is the blue color of the border */
    box-shadow: 0 0 3px #0070d2; /* This is the blue color of the shadow */  
}
.select2-container .select2-results .select2-results__options{
    border-color: rgb(21, 137, 238); /* This is the blue color of the border */
    box-shadow: 0 0 3px #0070d2; /* This is the blue color of the shadow */
}
/*End New Changes*/
/*DBS-190, Changes*/
.cCenterPanel .siteforceContentArea .ui-widget .row h3 {
  margin: 10px 0 20px 0 !important;
  font-size: 24px !important;
}

.cCenterPanel .siteforceContentArea .forceCommunityHtmlBlock p {
	font-size:16px;
}
.cFooterPanel .forceCommunityHtmlBlock p {
    font-size:16px;
}
.cCenterPanel .siteforceContentArea .forceCommunityHtmlBlock p.excerpt {
	font-size:14px;
}
/*End DBS-190*/

/* SECO-1989 GV:  Added below line to remove Illegal link on help.duo.com*/
.selfServiceUserProfileMenu .profileName { color:white; text-shadow:none; }
.selfServiceUserProfileMenu .login .login-link  { color:white !important; text-shadow:none !important; text-decoration:none !important }
